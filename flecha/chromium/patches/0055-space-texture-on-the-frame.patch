  private:
+  // The Space's texture over the window's colour: the shell's PNG tiled at the
+  // same size and strength as its CSS grain. No theme keeps the frame's own
+  // fine grain; a theme with no texture paints none.
+  void PaintSpaceTexture(gfx::Canvas* canvas, views::View* view) const {
+    if (!state_.texture) {
+      canvas->TileImageInt(FrameGrain(), 0, 0, view->width(), view->height());
+      return;
+    }
+    if (*state_.texture == "none" || state_.texture_strength <= 0) {
+      return;
+    }
+    const gfx::ImageSkia* texture = SpaceTexture(*state_.texture);
+    if (!texture) {
+      return;
+    }
+    // Zen's grain tile, and its opacity in the picker's CSS (styles.css).
+    const bool grain = *state_.texture == "grain";
+    const int tile = grain ? 155 : 100;
+    const double alpha =
+        grain ? 0.7 : (*state_.texture == "sand" ? 0.3 : 0.85);
+    const double strength = std::clamp(state_.texture_strength, 0.0, 1.0);
+    canvas->SaveLayerAlpha(static_cast<uint8_t>(
+        std::lround(std::clamp(255.0 * alpha * strength, 0.0, 255.0))));
+    for (int y = 0; y < view->height(); y += tile) {
+      for (int x = 0; x < view->width(); x += tile) {
+        canvas->DrawImageInt(*texture, 0, 0, texture->width(),
+                             texture->height(), x, y, tile, tile, false);
+      }
+    }
+    canvas->Restore();
+  }
+
   const FlechaFrameState state_;
 };
 
