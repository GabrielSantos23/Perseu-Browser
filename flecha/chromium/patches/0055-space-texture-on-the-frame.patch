+// The Space's grain texture, from the shell's own PNGs (ui/*-bg.png). Only the
+// textures the picker offers; the frame keeps its own grain without a texture.
+const gfx::ImageSkia* SpaceTexture(const std::string& name) {
+  if (name != "grain" && name != "sand" && name != "denim" &&
+      name != "tweed") {
+    return nullptr;
+  }
+  static base::NoDestructor<base::flat_map<std::string, gfx::ImageSkia>> cache;
+  auto it = cache->find(name);
+  if (it != cache->end()) {
+    return it->second.isNull() ? nullptr : &it->second;
+  }
+  gfx::ImageSkia texture;
+  base::FilePath dir;
+  if (base::PathService::Get(chrome::DIR_RESOURCES, &dir)) {
+    const base::FilePath path =
+        dir.AppendASCII("flecha-shell").AppendASCII(name + "-bg.png");
+    std::string bytes;
+    if (base::ReadFileToString(path, &bytes)) {
+      gfx::Image decoded =
+          gfx::Image::CreateFrom1xPNGBytes(base::as_byte_span(bytes));
+      if (!decoded.IsEmpty()) {
+        texture = decoded.AsImageSkia();
+      }
+    }
+  }
+  auto result = cache->emplace(name, std::move(texture));
+  return result.first->second.isNull() ? nullptr : &result.first->second;
+}
