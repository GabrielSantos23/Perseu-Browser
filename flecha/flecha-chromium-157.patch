index 0000000000000000000000000000000000000000..f4d99d50e70081a7cd0959bfeb7faf80ac47f3c2
--- /dev/null
+++ b/chrome/common/extensions/api/flecha_private.idl
@@ -0,0 +1,340 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Use the <code>chrome.flechaPrivate</code> API to lay out Flecha's browser
+// window: the shell's frame page (window.html) is a transparent view over the
+// window, and the browser places the page area and the window controls (the
+// macOS traffic lights) around it. Only Flecha's shell may use it; the
+// contract is chromium/shell/flechaPrivate.d.ts in the Flecha repo.
+namespace flechaPrivate {
+  // Where the sidebar is.
+  enum SidebarMode {
+    // A strip at the window's left edge; the page area is beside it.
+    docked,
+    // Out of the way; a thin strip at the left edge brings it back on hover.
+    hidden,
+    // Floating over the page, which stays where it is with the sidebar hidden.
+    floating
+  };
+
+  // What keyboard focus moves to.
+  enum FocusTarget {
+    // The frame page (for its command bar).
+    frame,
+    // The active page.
+    page
+  };
+
+  // The browser's colour scheme, like Electron's nativeTheme.themeSource.
+  enum Theme {
+    // Follow macOS's appearance.
+    system,
+    light,
+    dark
+  };
+
+  dictionary AnchorRect {
+    long x;
+    long y;
+    long width;
+    long height;
+  };
+
+  dictionary FrameState {
+    SidebarMode sidebar;
+    // The frame page covers the whole window (command bar, Peek, tour, tab
+    // drag); the page area doesn't move.
+    boolean overlay;
+    // The window's colour behind the page area, as #rrggbb.
+    DOMString background;
+    // The bar on top of the page area (window.html?kind=topbar), this tall in
+    // DIPs; 0 or absent for none. On Windows the window buttons sit at its
+    // right end.
+    long? topBar;
+    // The top bar's text colour as #rrggbb, for the window buttons' symbols.
+    DOMString? topBarForeground;
+  };
+
+  // A button of the sidebar's song card.
+  enum MediaCommand { play, pause, next, previous };
+
+  // What a tab is playing, from its media session (the same source as
+  // Chromium's global media controls).
+  dictionary MediaInfo {
+    boolean playing;
+    // From the page's Media Session metadata; empty when the page sets none.
+    DOMString title;
+    DOMString artist;
+    DOMString album;
+    boolean canNext;
+    boolean canPrevious;
+  };
+
+  callback MediaCallback = void(optional MediaInfo info);
+  callback ColorCallback = void(optional DOMString color);
+  dictionary NavigationState {
+    boolean canGoBack;
+    boolean canGoForward;
+    boolean loading;
+  };
+  callback NavigationStateCallback = void(NavigationState state);
+  callback DoneCallback = void();
+  callback AllowedCallback = void(boolean allowed);
+  callback WindowIdCallback = void(long windowId);
+  callback RejectedCallback = void(DOMString[] rejected);
+  callback TabIdCallback = void(long tabId);
+  callback WindowIdsCallback = void(long[] windowIds);
+
+  dictionary Bounds {
+    long x;
+    long y;
+    long width;
+    long height;
+  };
+
+  // The open Peek, for the frame page's backdrop and toolbar.
+  dictionary PeekState {
+    DOMString url;
+    DOMString title;
+    // Where Peek's page sits, in the frame page's coordinates.
+    Bounds bounds;
+  };
+
+  // Whether Flecha is the default browser, and whether it can make itself so.
+  dictionary DefaultBrowserState {
+    boolean isDefault;
+    boolean canSet;
+  };
+  callback DefaultBrowserCallback = void(DefaultBrowserState state);
+
+  dictionary DevToolsOptions {
+    // Close them if they're open (the Alt+Cmd+I menu item).
+    boolean? toggle;
+    // On the Console panel (the sidebar's error badge).
+    boolean? console;
+  };
+
+  // A new tab (createTab()).
+  dictionary CreateTabOptions {
+    // The window (default: Flecha's main window).
+    long? windowId;
+    // The page (default: the new tab page).
+    DOMString? url;
+    // Whether it becomes the window's active tab (default: true).
+    boolean? active;
+    // The storage partition of a Space with separate cookies and logins: the
+    // Space's id. Default: the profile's own storage.
+    DOMString? partition;
+  };
+
+  callback PartitionCallback = void(DOMString partition);
+
+  // What a new Flechinha shows.
+  dictionary FlechinhaOptions {
+    // A page to open (default: the new tab page).
+    DOMString? url;
+    // A tab to move into the Flechinha instead, from any window.
+    long? tabId;
+  };
+
+  // A newer Perseu to install. Checked by the shell against the signed feed.
+  dictionary BrowserUpdate {
+    DOMString version;
+    DOMString url;
+    DOMString sha256;
+  };
+  callback UpdateStatusCallback = void (DOMString status);
+
+  callback JsonCallback = void (DOMString json);
+
+  interface Functions {
+    // Windows: other browsers' bookmarks and history, as JSON.
+    static void detectImportBrowsers(JsonCallback callback);
+    static void readImportBrowser(DOMString id, JsonCallback callback);
+
+    // The first-run tour: makes the calling frame's window small and without
+    // buttons, or returns it to its size.
+    static void setWelcomeWindow(boolean welcome, optional DoneCallback callback);
+
+    // Downloads an update newer than this build and checks its hash. Status:
+    // "ready", "current", "unsupported", "busy" or "failed".
+    static void prepareUpdate(
+        BrowserUpdate update,
+        UpdateStatusCallback callback);
+    // Runs the update prepareUpdate() got ready, then restarts Perseu.
+    // Status: "restarting", "none", "busy" or "failed".
+    static void installUpdate(UpdateStatusCallback callback);
+
+    // Lays out a window's frame. Applies to every normal window (and to the
+    // windows opened later) when <code>windowId</code> is omitted.
+    static void setFrame(
+        FrameState state,
+        optional long windowId,
+        optional DoneCallback callback);
+
+    // Moves keyboard focus to the frame page or back to the active page, in
+    // the given window, the caller's window or the last active window.
+    static void focus(
+        FocusTarget target,
+        optional long windowId,
+        optional DoneCallback callback);
+
+    // The window the calling frame page belongs to.
+    static void getWindowId(WindowIdCallback callback);
+
+    // Flecha's keyboard shortcuts: <code>shortcuts</code> maps Electron
+    // accelerators ("CmdOrCtrl+Shift+T") to the shell's command ids. Flecha
+    // windows take these keys before the page and before Chromium's own
+    // shortcuts, and send them to onShortcut. Replaces the previous map. The
+    // callback gets the accelerators that couldn't be read.
+    static void setShortcuts(
+        object shortcuts,
+        optional RejectedCallback callback);
+
+    // Sets the browser's colour scheme: Chromium's own UI and pages'
+    // prefers-color-scheme (the frame page's too) follow it. Kept in the
+    // profile, like Settings > Appearance > Mode.
+    static void setTheme(Theme theme, optional DoneCallback callback);
+
+    // Whether a site may open Picture-in-Picture on its own when you switch
+    // away from a playing video (Chromium's Automatic picture-in-picture
+    // permission). <code>url</code> is any http(s) page of the site.
+    static void getAutoPip(DOMString url, AllowedCallback callback);
+
+    // Allows or blocks it for the site, as Chromium's site settings do.
+    static void setAutoPip(
+        DOMString url,
+        boolean allowed,
+        optional DoneCallback callback);
+
+    // What the tab is playing; no <code>info</code> when it has no media.
+    static void getMedia(long tabId, MediaCallback callback);
+
+    // The page's colour as #rrggbb, for the top bar: its theme-color, else
+    // its background once painted; nothing if it has neither yet.
+    static void getThemeColor(long tabId, ColorCallback callback);
+
+    // Whether the tab can go back or forward, and whether it is loading.
+    static void getNavigationState(
+        long tabId,
+        NavigationStateCallback callback);
+
+    // Stops the tab's page from loading further.
+    static void stopLoading(long tabId, optional DoneCallback callback);
+
+    // Plays, pauses or skips the tab's media, like the global media controls.
+    static void mediaAction(
+        long tabId,
+        MediaCommand action,
+        optional DoneCallback callback);
+
+    // Sets how much of a split view the first (left) pane takes, 0.1 to 0.9.
+    // <code>tabId</code> is either tab of the split.
+    static void setSplitRatio(
+        long tabId,
+        double ratio,
+        optional DoneCallback callback);
+
+    // Opens a Flechinha, Flecha's small window for one page: a normal window
+    // whose frame page is window.html?window=<id>&kind=flechinha, drawn as a
+    // toolbar across the top. The tabs its page opens go to Flecha's main
+    // window. Calls back with the new window's id.
+    static void openFlechinha(
+        optional FlechinhaOptions options,
+        optional WindowIdCallback callback);
+
+    // "Open in Flecha": moves the Flechinha's page to Flecha's main window
+    // (activated and in front) and closes the Flechinha. Calls back with the
+    // page's tab id.
+    static void openInFlecha(long windowId, optional TabIdCallback callback);
+
+    // Whether links from other apps (Flecha as the default browser) open in
+    // a Flechinha, once Flecha's window is up. On by default.
+    static void setOpenLinksInFlechinha(
+        boolean enabled,
+        optional DoneCallback callback);
+
+    // Peek: a page in a floating card over the page area of the given window
+    // (default: Flecha's main window), replacing any Peek there. Escape
+    // closes it; its links to new tabs open as tabs.
+    static void openPeek(
+        DOMString url,
+        optional long windowId,
+        optional DoneCallback callback);
+    static void closePeek(optional long windowId, optional DoneCallback callback);
+    // The Peek's page, as it is, becomes a normal tab of its window.
+    static void promotePeek(
+        optional long windowId,
+        optional DoneCallback callback);
+    // Tabs whose links to a new foreground tab (target=_blank) open in Peek
+    // instead, like the spike's pinned tabs. Replaces the previous list.
+    static void setPeekTabs(long[] tabIds, optional DoneCallback callback);
+
+    // Opens Developer Tools for a tab, docked or in their own window as last
+    // time.
+    static void openDevTools(
+        long tabId,
+        optional DevToolsOptions options,
+        optional DoneCallback callback);
+
+    // Does what clicking an extension's toolbar button does in Chromium (its
+    // popup, or action.onClicked) in the given window or the caller's. With the
+    // toolbar hidden, the popup opens beside `anchor`, a rect in the frame
+    // page's coordinates. Fails while the action is disabled on the active tab.
+    static void openExtensionAction(DOMString extensionId,
+        AnchorRect anchor,
+        optional long windowId,
+        optional DoneCallback callback);
+
+    // Chromium's find bar (find in page) in the given window or the main
+    // one, at the page area's top right.
+    static void showFindBar(optional long windowId, optional DoneCallback callback);
+    // Runs a browser command by name; see FlechaPrivateRunBrowserCommandFunction.
+    static void runBrowserCommand(DOMString command, optional long windowId, optional DoneCallback callback);
+
+    static void isDefaultBrowser(DefaultBrowserCallback callback);
+    // Asks macOS to make Flecha the default browser (it shows its own
+    // confirmation), then calls back with the result.
+    static void makeDefaultBrowser(DefaultBrowserCallback callback);
+
+    // The open Flechinhas' window ids.
