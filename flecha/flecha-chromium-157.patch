+ExtensionFunction::ResponseAction FlechaPrivateRunBrowserCommandFunction::Run() {
+  auto params = flecha_private::RunBrowserCommand::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  // Only what the shell's "more" menu offers, not any command id.
+  static constexpr auto kCommands =
+      base::MakeFixedFlatMap<std::string_view, int>({
+          {"about", IDC_ABOUT},
+          {"bookmarks", IDC_SHOW_BOOKMARK_MANAGER},
+          {"clearData", IDC_CLEAR_BROWSING_DATA},
+          {"downloads", IDC_SHOW_DOWNLOADS},
+          {"extensions", IDC_MANAGE_EXTENSIONS},
+          {"find", IDC_FIND},
+          {"newIncognitoWindow", IDC_NEW_INCOGNITO_WINDOW},
+          {"newWindow", IDC_NEW_WINDOW},
+          {"print", IDC_PRINT},
+          {"savePage", IDC_SAVE_PAGE},
+          {"taskManager", IDC_TASK_MANAGER},
+      });
+  const auto command = kCommands.find(params->command);
+  if (command == kCommands.end()) {
+    return RespondNow(Error("Unknown browser command."));
+  }
+  FlechaFrameHost* host =
+      params->window_id ? HostForWindow(*params->window_id, browser_context())
+                        : FlechaFrameHost::Main(browser_context());
+  if (!host) {
+    return RespondNow(Error(kNoWindowError, "(browser command)"));
+  }
+  if (!chrome::ExecuteCommand(host->GetBrowserWindowInterface(),
+                              command->second)) {
+    return RespondNow(Error("That command isn't available right now."));
+  }
+  return RespondNow(NoArguments());
+}
