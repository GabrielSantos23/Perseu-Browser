diff --git a/chrome/browser/extensions/api/flecha_private/flecha_browser_import.cc b/chrome/browser/extensions/api/flecha_private/flecha_browser_import.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7cb010d86391326c6a9f527d80bb71a86b4c067d
--- /dev/null
+++ b/chrome/browser/extensions/api/flecha_private/flecha_browser_import.cc
@@ -0,0 +1,258 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/flecha_private/flecha_browser_import.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_writer.h"
+#include "base/path_service.h"
+#include "base/strings/cstring_view.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "chrome/common/chrome_paths.h"
+#include "sql/database.h"
+#include "sql/statement.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "base/base_paths_win.h"
+#endif
+
+namespace {
+
+// Rows of history per profile, as in the macOS host.
+constexpr char kChromiumHistory[] =
+    "SELECT url, title, visit_count, last_visit_time / 1000 - 11644473600000 "
+    "FROM urls WHERE hidden = 0 AND last_visit_time > 0 "
+    "ORDER BY last_visit_time DESC LIMIT 5000";
+constexpr char kFirefoxHistory[] =
+    "SELECT url, title, visit_count, last_visit_date / 1000 FROM moz_places "
+    "WHERE hidden = 0 AND visit_count > 0 AND last_visit_date IS NOT NULL "
+    "ORDER BY last_visit_date DESC LIMIT 5000";
+constexpr char kFirefoxBookmarks[] =
+    "SELECT b.id, b.parent, b.type, b.title, b.guid, p.url "
+    "FROM moz_bookmarks b LEFT JOIN moz_places p ON p.id = b.fk "
+    "ORDER BY b.parent, b.position";
+
+struct Source {
+  const char* id;
+  const char* name;
+  bool firefox;
+  bool roaming;
+  const char* folder;
+  // The folder is the profile itself (Opera).
+  bool single_profile = false;
+};
+
+constexpr Source kSources[] = {
+    {"chrome", "Chrome", false, false, "Google\\Chrome\\User Data"},
+    {"edge", "Edge", false, false, "Microsoft\\Edge\\User Data"},
+    {"brave", "Brave", false, false, "BraveSoftware\\Brave-Browser\\User Data"},
+    {"vivaldi", "Vivaldi", false, false, "Vivaldi\\User Data"},
+    {"helium", "Helium", false, false, "imput\\Helium\\User Data"},
+    {"chromium", "Chromium", false, false, "Chromium\\User Data"},
+    {"opera", "Opera", false, true, "Opera Software\\Opera Stable", true},
+    {"opera-gx", "Opera GX", false, true, "Opera Software\\Opera GX Stable",
+     true},
+    {"firefox", "Firefox", true, true, "Mozilla\\Firefox\\Profiles"},
+    {"zen", "Zen", true, true, "zen\\Profiles"},
+    {"librewolf", "LibreWolf", true, true, "librewolf\\Profiles"},
+    {"waterfox", "Waterfox", true, true, "Waterfox\\Profiles"},
+    {"floorp", "Floorp", true, true, "Floorp\\Profiles"},
+};
+
+std::optional<base::FilePath> SourceRoot(const Source& source) {
+#if BUILDFLAG(IS_WIN)
+  base::FilePath root;
+  if (!base::PathService::Get(
+          source.roaming ? base::DIR_ROAMING_APP_DATA : base::DIR_LOCAL_APP_DATA,
+          &root)) {
+    return std::nullopt;
+  }
+  root = root.AppendASCII(source.folder);
+  base::FilePath own;
+  // Perseu never imports from itself.
+  if (base::PathService::Get(chrome::DIR_USER_DATA, &own) && own == root) {
+    return std::nullopt;
+  }
+  return root;
+#else
+  return std::nullopt;
+#endif
+}
+
+std::vector<base::FilePath> Profiles(const Source& source,
+                                     const base::FilePath& root) {
+  std::vector<base::FilePath> found;
+  if (source.single_profile) {
+    if (base::PathExists(root.AppendASCII("Bookmarks")) ||
+        base::PathExists(root.AppendASCII("History"))) {
+      found.push_back(root);
+    }
+    return found;
+  }
+  base::FileEnumerator dirs(root, false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+    if (source.firefox) {
+      if (base::PathExists(dir.AppendASCII("places.sqlite"))) {
+        found.push_back(dir);
+      }
+      continue;
+    }
+    const std::string name = dir.BaseName().AsUTF8Unsafe();
+    if ((name == "Default" || base::StartsWith(name, "Profile ")) &&
+        (base::PathExists(dir.AppendASCII("Bookmarks")) ||
+         base::PathExists(dir.AppendASCII("History")))) {
+      found.push_back(dir);
+    }
+  }
+  return found;
+}
+
+std::string ProfileName(const Source& source, const base::FilePath& dir) {
+  const std::string name = dir.BaseName().AsUTF8Unsafe();
+  const size_t dot = source.firefox ? name.find('.') : std::string::npos;
+  return dot == std::string::npos ? name : name.substr(dot + 1);
+}
+
+// The browser may have its database open, so a copy is read.
+bool OpenCopy(const base::FilePath& file,
+              const base::ScopedTempDir& temp,
+              sql::Database& db) {
+  const base::FilePath copy = temp.GetPath().Append(file.BaseName());
+  if (!base::CopyFile(file, copy)) {
+    return false;
+  }
+  // Recent writes may still be in the write-ahead log.
+  base::CopyFile(base::FilePath(file.value() + FILE_PATH_LITERAL("-wal")),
+                 base::FilePath(copy.value() + FILE_PATH_LITERAL("-wal")));
+  return db.Open(copy);
+}
+
+std::string Clean(std::string text) {
+  return base::IsStringUTF8(text) ? text : std::string();
+}
+
+base::ListValue ReadHistory(sql::Database& db, base::cstring_view query) {
+  base::ListValue rows;
+  sql::Statement statement(db.GetUniqueStatement(query));
+  while (statement.Step()) {
+    const std::string url = Clean(statement.ColumnString(0));
+    if (url.empty()) {
+      continue;
+    }
+    rows.Append(base::DictValue()
+                    .Set("url", url)
+                    .Set("title", Clean(statement.ColumnString(1)))
+                    .Set("visits", statement.ColumnInt(2))
+                    .Set("lastVisit",
+                         static_cast<double>(statement.ColumnInt64(3))));
+  }
+  return rows;
+}
+
+base::ListValue ReadFirefoxBookmarks(sql::Database& db) {
+  base::ListValue rows;
+  sql::Statement statement(db.GetUniqueStatement(kFirefoxBookmarks));
+  while (statement.Step()) {
+    rows.Append(base::DictValue()
+                    .Set("id", statement.ColumnInt(0))
+                    .Set("parent", statement.ColumnInt(1))
+                    .Set("type", statement.ColumnInt(2))
+                    .Set("title", Clean(statement.ColumnString(3)))
+                    .Set("guid", Clean(statement.ColumnString(4)))
+                    .Set("url", Clean(statement.ColumnString(5))));
+  }
+  return rows;
+}
+
+std::string ToJson(base::ValueView value) {
+  return base::WriteJson(value).value_or("null");
+}
+
+}  // namespace
+
+std::string FlechaDetectImportBrowsers() {
+  base::ListValue browsers;
+  for (const Source& source : kSources) {
+    const std::optional<base::FilePath> root = SourceRoot(source);
+    if (!root || !base::DirectoryExists(*root)) {
+      continue;
+    }
+    const std::vector<base::FilePath> profiles = Profiles(source, *root);
+    if (profiles.empty()) {
+      continue;
+    }
+    bool bookmarks = source.firefox;
+    bool history = source.firefox;
+    for (const base::FilePath& dir : profiles) {
+      bookmarks |= base::PathExists(dir.AppendASCII("Bookmarks"));
+      history |= base::PathExists(dir.AppendASCII("History"));
+    }
+    browsers.Append(base::DictValue()
+                        .Set("id", source.id)
+                        .Set("name", source.name)
+                        .Set("profiles", static_cast<int>(profiles.size()))
+                        .Set("hasBookmarks", bookmarks)
+                        .Set("hasHistory", history));
+  }
+  return ToJson(browsers);
+}
+
+std::string FlechaReadImportBrowser(const std::string& id) {
+  base::DictValue result;
+  base::ListValue profiles_out;
+  for (const Source& source : kSources) {
+    if (id != source.id) {
+      continue;
+    }
+    result.Set("name", source.name);
+    const std::optional<base::FilePath> root = SourceRoot(source);
+    if (!root) {
+      break;
+    }
+    for (const base::FilePath& dir : Profiles(source, *root)) {
+      base::DictValue profile;
+      profile.Set("name", ProfileName(source, dir));
+      base::ScopedTempDir temp;
+      if (!temp.CreateUniqueTempDir()) {
+        continue;
+      }
+      sql::Database db(sql::Database::Tag("FirefoxImporter"));
+      if (source.firefox) {
+        if (OpenCopy(dir.AppendASCII("places.sqlite"), temp, db)) {
+          profile.Set("firefox", ReadFirefoxBookmarks(db));
+          profile.Set("history", ReadHistory(db, kFirefoxHistory));
+        }
+      } else {
+        base::ListValue documents;
+        for (const char* file : {"Bookmarks", "AccountBookmarks"}) {
+          std::string text;
+          if (base::ReadFileToString(dir.AppendASCII(file), &text) &&
+              base::IsStringUTF8(text)) {
+            documents.Append(std::move(text));
+          }
+        }
+        profile.Set("chromium", std::move(documents));
+        const base::FilePath history = dir.AppendASCII("History");
+        if (base::PathExists(history) && OpenCopy(history, temp, db)) {
+          profile.Set("history", ReadHistory(db, kChromiumHistory));
+        }
+      }
+      profiles_out.Append(std::move(profile));
+    }
+    break;
+  }
+  result.Set("profiles", std::move(profiles_out));
+  return ToJson(result);
+}
