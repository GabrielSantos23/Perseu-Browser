+constexpr int64_t kMaxUpdateBytes = 1024LL * 1024 * 1024;
+
+struct ReadyUpdate {
+  base::FilePath file;
+  std::string version;
+  bool busy = false;
+};
+
+ReadyUpdate& Update() {
+  static base::NoDestructor<ReadyUpdate> update;
+  return *update;
+}
+
+// An installed copy has setup.exe next to its versioned files; a build folder
+// doesn't, and the installer would update some other copy.
+bool IsInstalledBuild() {
+  base::FilePath exe_dir;
+  return base::PathService::Get(base::DIR_EXE, &exe_dir) &&
+         base::PathExists(exe_dir.AppendASCII(version_info::GetVersionNumber())
+                              .AppendASCII("Installer")
+                              .AppendASCII("setup.exe"));
+}
+
+bool VerifyAndKeep(const base::FilePath& temp,
+                   const std::string& sha256,
+                   const base::FilePath& target) {
+  std::optional<std::vector<uint8_t>> bytes = base::ReadFileToBytes(temp);
+  const bool ok = bytes && base::ToLowerASCII(base::HexEncode(
+                               crypto::hash::Sha256(*bytes))) == sha256;
+  if (ok && base::ReplaceFile(temp, target, nullptr)) {
+    return true;
+  }
+  base::DeleteFile(temp);
+  return false;
+}
+
+#if BUILDFLAG(IS_WIN)
+bool RunInstaller(const base::FilePath& file) {
+  base::CommandLine command(file);
+  command.AppendSwitch("do-not-launch-chrome");
+  base::Process process = base::LaunchProcess(command, base::LaunchOptions());
+  int exit_code = -1;
+  const bool ok = process.IsValid() &&
+                  process.WaitForExitWithTimeout(base::Minutes(10), &exit_code) &&
+                  exit_code == 0;
+  base::DeleteFile(file);
+  return ok;
+}
+#endif
+
+constexpr base::TaskTraits kUpdateFileTraits = {
+    base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+    base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN};
+
+}  // namespace
+
+FlechaPrivatePrepareUpdateFunction::~FlechaPrivatePrepareUpdateFunction() =
+    default;
+
+ExtensionFunction::ResponseAction FlechaPrivatePrepareUpdateFunction::Run() {
+  auto params = flecha_private::PrepareUpdate::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+#if BUILDFLAG(IS_WIN)
+  const base::Version version(params->update.version);
+  url_ = GURL(params->update.url);
+  sha256_ = base::ToLowerASCII(params->update.sha256);
+  std::vector<uint8_t> hash;
+  if (!version.IsValid() || !url_.SchemeIs(url::kHttpsScheme) ||
+      !base::HexStringToBytes(sha256_, &hash) ||
+      hash.size() != crypto::hash::kSha256Size) {
+    return RespondNow(Error("Invalid update"));
+  }
+  if (version <= version_info::GetVersion()) {
+    return RespondNow(WithArguments("current"));
+  }
+  version_ = version.GetString();
+  if (Update().version == version_ && !Update().file.empty()) {
+    return RespondNow(WithArguments("ready"));
+  }
+  if (Update().busy) {
+    return RespondNow(WithArguments("busy"));
+  }
+  Update().busy = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kUpdateFileTraits, base::BindOnce(&IsInstalledBuild),
+      base::BindOnce(&FlechaPrivatePrepareUpdateFunction::OnInstalledChecked,
+                     this));
+  return RespondLater();
+#else
+  return RespondNow(WithArguments("unsupported"));
+#endif
+}
+
+void FlechaPrivatePrepareUpdateFunction::OnInstalledChecked(bool installed) {
+  base::FilePath temp_dir;
+  if (!installed || install_static::IsSystemInstall()) {
+    Finish("unsupported");
+    return;
+  }
+  if (!base::PathService::Get(base::DIR_TEMP, &temp_dir)) {
+    Finish("failed");
+    return;
+  }
+  target_ = temp_dir.AppendASCII("perseu-update-" + version_ + ".exe");
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url_;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+net::DefineNetworkTrafficAnnotation("flecha_browser_update", R"(
+        semantics {
+          sender: "Perseu updater"
+          description: "Downloads a newer Perseu installer named by the signed update feed."
+          trigger: "A periodic update check finds a newer version."
+          data: "None."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not configurable."
+          policy_exception_justification: "Not implemented."
+        })"));
+  loader_->DownloadToTempFile(
+      browser_context()
+          ->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&FlechaPrivatePrepareUpdateFunction::OnDownloaded, this),
+      kMaxUpdateBytes);
+}
+
+void FlechaPrivatePrepareUpdateFunction::OnDownloaded(base::FilePath file) {
+  if (file.empty()) {
+    Finish("failed");
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kUpdateFileTraits,
+      base::BindOnce(&VerifyAndKeep, file, sha256_, target_),
+      base::BindOnce(&FlechaPrivatePrepareUpdateFunction::OnVerified, this));
+}
+
+void FlechaPrivatePrepareUpdateFunction::OnVerified(bool ok) {
+  if (ok) {
+    Update().file = target_;
+    Update().version = version_;
+  }
+  Finish(ok ? "ready" : "failed");
+}
+
+void FlechaPrivatePrepareUpdateFunction::Finish(const std::string& status) {
+  Update().busy = false;
+  Respond(WithArguments(status));
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateInstallUpdateFunction::Run() {
+#if BUILDFLAG(IS_WIN)
+  if (Update().busy) {
+    return RespondNow(WithArguments("busy"));
+  }
+  if (Update().file.empty()) {
+    return RespondNow(WithArguments("none"));
+  }
+  Update().busy = true;
+  base::FilePath file = std::move(Update().file);
+  Update().file.clear();
+  Update().version.clear();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, kUpdateFileTraits, base::BindOnce(&RunInstaller, file),
+      base::BindOnce(&FlechaPrivateInstallUpdateFunction::OnInstalled, this));
+  return RespondLater();
+#else
+  return RespondNow(WithArguments("none"));
+#endif
+}
+
+void FlechaPrivateInstallUpdateFunction::OnInstalled(bool ok) {
+  Update().busy = false;
+  Respond(WithArguments(ok ? "restarting" : "failed"));
+  if (ok) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&chrome::AttemptRestart));
+  }
+}
