+ExtensionFunction::ResponseAction
+FlechaPrivateOpenExtensionActionFunction::Run() {
+  auto params = flecha_private::OpenExtensionAction::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host =
+      params->window_id ? HostForWindow(*params->window_id, browser_context())
+                        : HostForContents(GetSenderWebContents());
+  if (!host) {
+    return RespondNow(Error(kNoWindowError, "(extension action)"));
+  }
+  BrowserWindowInterface* browser = host->GetBrowserWindowInterface();
+  ExtensionsContainer* container = ExtensionsContainer::From(*browser);
+  ToolbarActionViewModel* action =
+      container ? container->GetActionForId(params->extension_id) : nullptr;
+  if (!action) {
+    return RespondNow(Error("No action for extension *.", params->extension_id));
+  }
+  // Chromium would fall back to the action's context menu, on a toolbar button
+  // nobody can see.
+  if (!action->IsEnabled(browser->GetActiveTabInterface()->GetContents())) {
+    return RespondNow(Error("The action is disabled on this tab."));
+  }
+  host->SetPopupAnchor(gfx::Rect(params->anchor.x, params->anchor.y,
+                                 params->anchor.width, params->anchor.height));
+  action->ExecuteUserAction(
+      ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  return RespondNow(NoArguments());
+}
