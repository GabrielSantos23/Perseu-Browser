+ExtensionFunction::ResponseAction FlechaPrivateGetMediaFunction::Run() {
+  auto params = flecha_private::GetMedia::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  content::MediaSession* session = content::MediaSession::GetIfExists(contents);
+  if (!session) {
+    return RespondNow(NoArguments());
+  }
+  media_session::mojom::MediaSessionInfoPtr info =
+      session->GetMediaSessionInfoSync();
+  if (!info || info->state ==
+                   media_session::mojom::MediaSessionInfo::SessionState::kInactive) {
+    return RespondNow(NoArguments());
+  }
+  const media_session::MediaMetadata& metadata =
+      session->GetMediaSessionMetadata();
+  const auto actions = session->GetMediaSessionActionsSync();
+  flecha_private::MediaInfo result;
+  result.playing = info->playback_state ==
+                   media_session::mojom::MediaPlaybackState::kPlaying;
+  result.title = base::UTF16ToUTF8(metadata.title);
+  result.artist = base::UTF16ToUTF8(metadata.artist);
+  result.album = base::UTF16ToUTF8(metadata.album);
+  result.can_next = std::ranges::contains(
+      actions, media_session::mojom::MediaSessionAction::kNextTrack);
+  result.can_previous = std::ranges::contains(
+      actions, media_session::mojom::MediaSessionAction::kPreviousTrack);
+  return RespondNow(ArgumentList(
+      flecha_private::GetMedia::Results::Create(result)));
+}
