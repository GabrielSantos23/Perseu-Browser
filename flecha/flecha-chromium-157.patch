+// static
+FlechaFrameView* FlechaFrameView::MaybeCreate(BrowserView* browser_view) {
+  // Incognito windows too: their frame page is the incognito shell's.
+  if (!FlechaHidesTopChrome(browser_view->browser())) {
+    return nullptr;
+  }
+  FlechaFrameView* frame = browser_view->AddChildView(
+      std::make_unique<FlechaFrameView>(browser_view));
+  // Above the frame.
+  frame->peek_view_.SetView(
+      browser_view->AddChildView(std::make_unique<FlechaPeekWebView>(
+          browser_view->browser()->GetProfile(),
+          base::BindRepeating(&FlechaFrameView::SendPeekChanged,
+                              frame->weak_factory_.GetWeakPtr()))));
+  return frame;
+}
+
+// static
+FlechaFrameView* FlechaFrameView::From(views::View* browser_view) {
+  if (!browser_view) {
+    return nullptr;
+  }
+  for (views::View* child : browser_view->children()) {
+    if (auto* frame = views::AsViewClass<FlechaFrameView>(child)) {
+      return frame;
+    }
+  }
+  return nullptr;
+}
+
+FlechaFrameView::FlechaFrameView(BrowserView* browser_view)
+    : views::WebView(browser_view->browser()->GetProfile()), browser_view_(browser_view) {
+  // Stays hidden until the shell is loaded and the frame page opens.
+  SetVisible(false);
+  // Under every other view of the window.
+  background_view_.SetView(browser_view->AddChildViewAt(
+      std::make_unique<FlechaFrameBackgroundView>(), 0));
+  // Above the page area and under this view, added next (its overlay covers
+  // the top bar).
+  auto top_bar =
+      std::make_unique<views::WebView>(browser_view->browser()->GetProfile());
+  top_bar->SetVisible(false);
+  top_bar_view_.SetView(browser_view->AddChildView(std::move(top_bar)));
+  // Until the shell says otherwise (a popup an extension's shortcut opened),
+  // just past the sidebar's top.
+  auto popup_anchor = std::make_unique<views::View>();
+  popup_anchor->SetCanProcessEventsWithinSubtree(false);
+  popup_anchor->SetBoundsRect(
+      gfx::Rect(kFlechaSidebarWidth - kFlechaGap, kFlechaGap, 1, 1));
+  popup_anchor_.SetView(browser_view->AddChildView(std::move(popup_anchor)));
+  if (const auto& state = FlechaFrameHost::DefaultState()) {
+    state_ = *state;
+  }
+  state_.flechinha = FlechaFrameHost::CreatingFlechinha();
+  if (state_.flechinha) {
+    state_.overlay = false;
+  }
+  ApplyState();
+
+  auto* registry = extensions::ExtensionRegistry::Get(GetBrowserContext());
+  registry_observation_.Observe(registry);
+  if (registry->ready_extensions().Contains(kFlechaShellExtensionId)) {
+    OpenFramePage();
+  }
+}
+
+FlechaFrameView::~FlechaFrameView() {
+  UnregisterShortcuts();
+  if (auto* peek_view = views::AsViewClass<views::WebView>(peek_view_.view())) {
+    peek_view->SetWebContents(nullptr);
+  }
+  peek_.reset();
+  if (auto* top_bar = views::AsViewClass<views::WebView>(top_bar_view_.view())) {
+    top_bar->SetWebContents(nullptr);
+  }
+  SetWebContents(nullptr);
+}
+
+void FlechaFrameView::OpenPeek(const GURL& url, content::WebContents* source) {
+  content::BrowserContext* context = GetBrowserContext();
+  scoped_refptr<content::SiteInstance> space =
+      FlechaSiteInstanceFor(source, url);
+  std::unique_ptr<content::WebContents> contents = content::WebContents::Create(
+      space ? content::WebContents::CreateParams(context, std::move(space))
+            : content::WebContents::CreateParams(context));
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_LINK, std::string());
+  OpenPeekWithContents(std::move(contents));
+}
+
+void FlechaFrameView::OpenPeekWithContents(
+    std::unique_ptr<content::WebContents> contents) {
+  auto* peek_view = views::AsViewClass<views::WebView>(peek_view_.view());
+  if (!peek_view || !contents) {
+    return;
+  }
+  if (peek_) {
+    peek_view->SetWebContents(nullptr);
+    peek_.reset();
+  }
+  peek_ = std::make_unique<Peek>(this, std::move(contents));
+  peek_view->SetWebContents(peek_->contents());
+  peek_view->holder()->SetNativeViewCornerRadii(
+      gfx::RoundedCornersF(kFlechaPageCornerRadius));
+  peek_view->SetVisible(true);
+  // The frame covers the window while a Peek is open: it draws the backdrop
+  // and Peek's toolbar.
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+  peek_view->RequestFocus();
+  peek_->contents()->Focus();
+  SendPeekChanged();
+}
+
+void FlechaFrameView::ClosePeek() {
+  if (!peek_) {
+    return;
+  }
+  if (auto* peek_view = views::AsViewClass<views::WebView>(peek_view_.view())) {
+    peek_view->SetWebContents(nullptr);
+    peek_view->SetVisible(false);
+  }
+  peek_.reset();
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+  SendPeekChanged();
+  FocusPage();
+}
+
+void FlechaFrameView::PromotePeek() {
+  if (!peek_) {
+    return;
+  }
+  if (auto* peek_view = views::AsViewClass<views::WebView>(peek_view_.view())) {
+    peek_view->SetWebContents(nullptr);
+    peek_view->SetVisible(false);
+  }
+  std::unique_ptr<content::WebContents> contents = peek_->Release();
+  peek_.reset();
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+  SendPeekChanged();
+  // The page, as it is, becomes a tab; the shell adopts it (tabs.onCreated).
+  browser_view_->browser()->GetTabStripModel()->AppendWebContents(
+      std::move(contents), /*foreground=*/true);
+}
+
+bool FlechaFrameView::HasPeek() const {
+  return !!peek_;
+}
+
+content::WebContents* FlechaFrameView::GetPeekContents() {
+  return peek_ ? peek_->contents() : nullptr;
+}
+
+void FlechaFrameView::SendPeekChanged() {
+  base::ListValue args;
+  args.Append(GetWindowId());
+  views::View* peek_view = peek_view_.view();
+  if (peek_ && peek_view) {
+    content::WebContents* contents = peek_->contents();
+    // In the frame page's coordinates (the frame view's).
+    const gfx::Rect peek_bounds =
+        peek_view->bounds() - bounds().OffsetFromOrigin();
+    // Not laid out yet; the bounds change comes next.
+    if (peek_bounds.IsEmpty()) {
+      return;
+    }
+    args.Append(
+        base::DictValue()
+            .Set("url", contents->GetLastCommittedURL().is_empty()
+                            ? contents->GetVisibleURL().spec()
+                            : contents->GetLastCommittedURL().spec())
+            .Set("title", contents->GetTitle())
+            .Set("bounds", base::DictValue()
+                               .Set("x", peek_bounds.x())
+                               .Set("y", peek_bounds.y())
+                               .Set("width", peek_bounds.width())
+                               .Set("height", peek_bounds.height())));
+  }
+  DispatchFlechaShellEvent(
+      Profile::FromBrowserContext(GetBrowserContext()),
+      "flechaPrivate.onPeekChanged", std::move(args));
+}
+
+void FlechaFrameView::SetWelcome(bool welcome) {
+  if (state_.flechinha) {
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(GetBrowserContext());
+  if (!welcome && !profile->IsOffTheRecord()) {
+    profile->GetPrefs()->SetBoolean(kFlechaWelcomeDonePref, true);
+  }
+  views::Widget* widget = browser_view_->GetWidget();
+  if (welcome_ == welcome || !widget) {
+    return;
+  }
+  welcome_ = welcome;
+  browser_view_->SetCanResize(!welcome);
+  browser_view_->SetCanMaximize(!welcome);
+  gfx::Rect work_area = display::Screen::Get()
+                            ->GetDisplayNearestWindow(widget->GetNativeWindow())
+                            .work_area();
+  if (welcome && widget->IsVisible()) {
+    welcome_restore_maximized_ = widget->IsMaximized();
+    welcome_restore_bounds_ = widget->GetRestoredBounds();
+    if (welcome_restore_maximized_) {
+      widget->Restore();
+    }
+    work_area.ClampToCenteredSize(
+        gfx::Size(kFlechaWelcomeWidth, kFlechaWelcomeHeight));
+    widget->SetBounds(work_area);
+  } else if (!welcome) {
+    // A first run has no earlier size to go back to.
+    if (welcome_restore_bounds_.IsEmpty()) {
+      work_area.ClampToCenteredSize(gfx::Size(1600, 1000));
+      welcome_restore_bounds_ = work_area;
+    }
+    widget->SetBounds(welcome_restore_bounds_);
+    welcome_restore_bounds_ = gfx::Rect();
+    if (welcome_restore_maximized_) {
+      widget->Maximize();
+    }
+  }
+  if (widget->non_client_view()) {
+    widget->non_client_view()->InvalidateLayout();
+  }
+}
+
+void FlechaFrameView::AddedToWidget() {
+  views::WebView::AddedToWidget();
+  ApplyState();
+  UpdateShortcuts();
+  Profile* profile = Profile::FromBrowserContext(GetBrowserContext());
+  if (!state_.flechinha && !profile->IsOffTheRecord() &&
+      !profile->GetPrefs()->GetBoolean(kFlechaWelcomeDonePref)) {
+    SetWelcome(true);
+  }
+}
+
+void FlechaFrameView::RemovedFromWidget() {
+  UnregisterShortcuts();
+  views::WebView::RemovedFromWidget();
+}
+
+void FlechaFrameView::UpdateShortcuts() {
+  UnregisterShortcuts();
+  views::FocusManager* focus_manager = GetFocusManager();
+  if (!focus_manager) {
+    return;
+  }
+  shortcuts_focus_manager_ = focus_manager;
+  for (const auto& [accelerator, command] : FlechaFrameHost::Shortcuts()) {
+    focus_manager->RegisterAccelerator(
+        accelerator, ui::AcceleratorManager::kHighPriority, &shortcut_target_);
+  }
+}
+
+void FlechaFrameView::UnregisterShortcuts() {
+  if (shortcuts_focus_manager_) {
+    shortcuts_focus_manager_->UnregisterAccelerators(&shortcut_target_);
+    shortcuts_focus_manager_ = nullptr;
+  }
+}
+
+bool FlechaFrameView::ShortcutTarget::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  const auto& shortcuts = FlechaFrameHost::Shortcuts();
+  // The focus manager matches without the repeat flag; so does the map.
+  const auto it = shortcuts.find(
+      ui::Accelerator(accelerator.key_code(), accelerator.modifiers()));
+  if (it == shortcuts.end()) {
+    return false;
+  }
+  Profile* profile = FlechaShellProfile(
+      Profile::FromBrowserContext(frame_->GetBrowserContext()));
+  if (!extensions::ExtensionRegistry::Get(profile)
+           ->enabled_extensions()
+           .Contains(kFlechaShellExtensionId)) {
+    return false;
+  }
+  auto args = base::MakeRefCounted<extensions::EventArgs>();
+  args->data.Append(it->second);
+  args->data.Append(frame_->GetWindowId());
+  auto event = std::make_unique<extensions::Event>(
+      extensions::events::UNKNOWN, "flechaPrivate.onShortcut",
+      std::move(args), profile);
+  event->user_gesture = extensions::EventRouter::UserGestureState::kEnabled;
+  extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+      kFlechaShellExtensionId, std::move(event));
+  return true;
+}
+
+bool FlechaFrameView::ShortcutTarget::CanHandleAccelerators() const {
+  return frame_->IsActive();
+}
+
+gfx::Size FlechaFrameView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // The browser view layout reads the frame's size from here (it doesn't know
+  // this class); a height of 0 is as tall as the window.
+  // While a Peek is open the frame covers the window, for its backdrop.
+  FlechaFrameState state = state_;
+  state.overlay = state.overlay || HasPeek();
+  return gfx::Size(state.FrameWidth(kOverlayWidth),
+                   state.flechinha && !state.overlay
+                       ? state.FrameHeight(kOverlayWidth)
+                       : 0);
+}
+
+bool FlechaFrameView::IsFlechinha() const {
+  return state_.flechinha;
+}
+
+BrowserWindowInterface* FlechaFrameView::GetBrowserWindowInterface() {
+  return browser_view_->browser();
+}
+
+int FlechaFrameView::GetWindowId() const {
+  return browser_view_->browser()->GetSessionID().id();
+}
+
+content::BrowserContext* FlechaFrameView::GetBrowserContext() {
+  return browser_view_->browser()->GetProfile();
+}
+
+content::WebContents* FlechaFrameView::GetFrameContents() {
+  return frame_contents_.get();
+}
+
+content::WebContents* FlechaFrameView::GetTopBarContents() {
+  return top_bar_contents_.get();
+}
+
+bool FlechaFrameView::IsActiveWindow() const {
+  return browser_view_->IsActive();
+}
+
+void FlechaFrameView::SetFrameState(const FlechaFrameState& new_state) {
+  FlechaFrameState state = new_state;
+  state.flechinha = state_.flechinha;
+  state.fullscreen = state_.fullscreen;
+  state.content_fullscreen = state_.content_fullscreen;
+  if (state == state_) {
+    return;
+  }
+  state_ = state;
+  ApplyState();
+}
+
+void FlechaFrameView::FocusFrame() {
+  if (frame_contents_) {
+    RequestFocus();
+    frame_contents_->Focus();
+  }
+}
+
+void FlechaFrameView::SetPopupAnchor(const gfx::Rect& rect) {
+  if (views::View* anchor = popup_anchor_.view()) {
+    gfx::Point origin = rect.origin();
+    views::View::ConvertPointToTarget(this, browser_view_, &origin);
+    anchor->SetBoundsRect(gfx::Rect(origin, rect.size()));
+  }
+}
+
+void FlechaFrameView::FocusPage() {
+  if (views::WebView* page = browser_view_->GetActiveContentsWebView()) {
+    page->RequestFocus();
+    if (page->web_contents()) {
+      page->web_contents()->Focus();
+    }
+  }
+}
+
+content::WebContents* FlechaFrameView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // The frame page stays the shell's; anything else it opens goes to a tab.
+  WindowOpenDisposition disposition = params.disposition;
+  if (disposition == WindowOpenDisposition::CURRENT_TAB) {
+    if (params.url.SchemeIs(extensions::kExtensionScheme) &&
+        IsFlechaShell(params.url.host())) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+  browser_view_->browser()->OpenGURL(params.url, disposition);
+  return nullptr;
+}
+
+content::KeyboardEventProcessingResult FlechaFrameView::PreHandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // The window's shortcuts (Cmd+T, Cmd+L, ...) work with the frame focused.
+  // Keys without Command or Control are the frame page's own, as in a tab
+  // before the browser's accelerators: Escape closes the command bar rather
+  // than reaching the window (which swallows it).
+  constexpr int kShortcutModifiers =
+      blink::WebInputEvent::kMetaKey | blink::WebInputEvent::kControlKey;
+  if (!(event.GetModifiers() & kShortcutModifiers)) {
+    return content::KeyboardEventProcessingResult::NOT_HANDLED;
+  }
+  return browser_view_->PreHandleKeyboardEvent(event);
+}
+
+bool FlechaFrameView::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  return browser_view_->HandleKeyboardEvent(event);
+}
+
+void FlechaFrameView::DraggableRegionsChanged(
+    const std::vector<blink::mojom::DraggableRegionPtr>& regions,
+    content::WebContents* contents) {
+  // Each page fills its view, so its coordinates are its view's.
+  if (contents && contents == top_bar_contents_.get()) {
+    top_bar_draggable_region_ = gfx::DraggableRegionsToSkRegion(regions);
+    return;
+  }
+  draggable_region_ = gfx::DraggableRegionsToSkRegion(regions);
+}
+
+blink::mojom::DisplayMode FlechaFrameView::GetDisplayMode(
+    const content::WebContents* source) {
+  return state_.fullscreen ? blink::mojom::DisplayMode::kFullscreen
+                           : blink::mojom::DisplayMode::kBrowser;
+}
+
+void FlechaFrameView::OnWindowFullscreenChanged() {
+  const bool fullscreen = browser_view_->IsFullscreen();
+  const bool content_fullscreen =
+      fullscreen && ExclusiveAccessManager::From(browser_view_->browser())
+                        ->fullscreen_controller()
+                        ->IsWindowFullscreenForTabOrPending();
+  if (fullscreen == state_.fullscreen &&
+      content_fullscreen == state_.content_fullscreen) {
+    return;
+  }
+  state_.fullscreen = fullscreen;
+  state_.content_fullscreen = content_fullscreen;
+  ApplyState();
+  // The frame page reads it as (display-mode: fullscreen), from its visual
+  // properties.
+  if (frame_contents_) {
+    if (content::RenderFrameHost* frame =
+            frame_contents_->GetPrimaryMainFrame()) {
+      if (content::RenderWidgetHost* widget = frame->GetRenderWidgetHost()) {
+        widget->SynchronizeVisualProperties();
+      }
+    }
+  }
+}
+
+int FlechaFrameView::NonClientHitTest(const gfx::Point& point) const {
+  if (!IsActive()) {
+    return HTNOWHERE;
+  }
+  // Peek's page is above the frame page and its drag areas.
+  if (const views::View* peek = peek_view_.view();
+      peek && peek->GetVisible() && peek->bounds().Contains(point)) {
+    return HTCLIENT;
+  }
+  if (bounds().Contains(point)) {
+    const gfx::Point local = point - bounds().OffsetFromOrigin();
+    return draggable_region_.contains(local.x(), local.y()) ? HTCAPTION
+                                                            : HTCLIENT;
+  }
+  if (const views::View* top_bar = top_bar_view_.view();
+      top_bar && top_bar->GetVisible() && top_bar->bounds().Contains(point)) {
+    const gfx::Point local = point - top_bar->bounds().OffsetFromOrigin();
+    return top_bar_draggable_region_.contains(local.x(), local.y())
+               ? HTCAPTION
+               : HTCLIENT;
+  }
+  // The window background around the page area moves the window, as a title
+  // bar would.
+  if (const views::View* background = background_view_.view()) {
+    gfx::Rect page = background->bounds();
+    page.Inset(background->GetInsets());
+    if (background->bounds().Contains(point) && !page.Contains(point)) {
+      return HTCAPTION;
+    }
+    // The page area is the page's up to its top edge. Left to BrowserView, the
+    // band where the hidden tab strip would be counts as title bar.
+    if (page.Contains(point)) {
+      return HTCLIENT;
+    }
+  }
+  return HTNOWHERE;
+}
+
+void FlechaFrameView::OnExtensionReady(content::BrowserContext* browser_context,
+                                       const extensions::Extension* extension) {
+  if (IsFlechaShell(extension->id())) {
+    OpenFramePage();
+  }
+}
+
+void FlechaFrameView::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UnloadedExtensionReason reason) {
+  if (IsFlechaShell(extension->id())) {
+    CloseFramePage();
+  }
+}
+
+void FlechaFrameView::OpenFramePage() {
+  CloseFramePage();
+
+  frame_contents_ =
+      CreateShellPage(state_.flechinha ? "&kind=flechinha" : "");
+  draggable_region_.setEmpty();
+  SetWebContents(frame_contents_.get());
+  if (!state_.flechinha) {
+    if (auto* top_bar =
+            views::AsViewClass<views::WebView>(top_bar_view_.view())) {
+      top_bar_contents_ = CreateShellPage("&kind=topbar");
+      top_bar_draggable_region_.setEmpty();
+      top_bar->SetWebContents(top_bar_contents_.get());
+    }
+  }
+
+  SetVisible(true);
+  if (views::View* background = background_view()) {
+    background->SetVisible(true);
+  }
+  ApplyState();
+}
+
+std::unique_ptr<content::WebContents> FlechaFrameView::CreateShellPage(
+    const std::string& query) {
+  const GURL url =
+      extensions::Extension::GetBaseURLFromExtensionId(kFlechaShellExtensionId)
+          .Resolve("window.html?window=" +
+                   base::NumberToString(GetWindowId()) + query);
+  content::BrowserContext* context = GetBrowserContext();
+  auto contents = content::WebContents::Create(content::WebContents::CreateParams(
+      context, content::SiteInstance::CreateForURL(context, url)));
+  // The page area shows through wherever the page draws nothing.
+  views::WebContentsSetBackgroundColor::CreateForWebContentsWithColor(
+      contents.get(), SK_ColorTRANSPARENT);
+  extensions::SetViewType(contents.get(),
+                          extensions::mojom::ViewType::kComponent);
+  extensions::ChromeExtensionWebContentsObserver::CreateForWebContents(
+      contents.get());
+  contents->SetDelegate(this);
+  // -webkit-app-region marks the parts of the page that move the window.
+  contents->SetSupportsDraggableRegions(true);
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+  return contents;
+}
+
+void FlechaFrameView::CloseFramePage() {
+  if (!frame_contents_) {
+    return;
+  }
+  if (auto* top_bar = views::AsViewClass<views::WebView>(top_bar_view_.view())) {
+    top_bar->SetVisible(false);
+    top_bar->SetWebContents(nullptr);
+  }
+  top_bar_contents_.reset();
+  SetVisible(false);
+  if (views::View* background = background_view()) {
+    background->SetVisible(false);
+  }
+  SetWebContents(nullptr);
+  frame_contents_.reset();
+  ApplyState();
+}
+
+void FlechaFrameView::ApplyState() {
+  if (views::View* background = background_view()) {
+    background->SetBackground(std::make_unique<FlechaFrameBackground>(state_));
+    background->SetBorder(views::CreateEmptyBorder(state_.PageInsets()));
+  }
+  if (views::View* top_bar = top_bar_view_.view()) {
+    top_bar->SetVisible(IsActive() && top_bar_contents_ &&
+                        !state_.TopBarBounds(gfx::Size(1 << 16, 1 << 16))
+                             .IsEmpty());
+  }
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+  // The window buttons (Windows) follow the top bar.
+  if (views::Widget* widget = GetWidget(); widget && widget->non_client_view()) {
+    widget->non_client_view()->frame_view()->InvalidateLayout();
+  }
+  // The traffic lights sit in the frame page's toolbar row, and go with it.
+  SetFlechaTrafficLights(GetWidget(), IsActive() ? &state_ : nullptr);
+}
+
+BEGIN_METADATA(FlechaFrameView)
+END_METADATA
