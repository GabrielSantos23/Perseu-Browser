+// Where a new Flechinha goes, like the Electron spike's Flechinhas.placement():
+// centred on the display under the pointer, at most 900x700, each one a step
+// down and right of the others there.
+gfx::Rect FlechinhaBounds(content::BrowserContext* context) {
+  constexpr int kWidth = 900;
+  constexpr int kHeight = 700;
+  constexpr int kCascade = 26;
+  display::Screen* screen = display::Screen::Get();
+  const display::Display display =
+      screen->GetDisplayNearestPoint(screen->GetCursorScreenPoint());
+  const gfx::Rect area = display.work_area();
+  const int width = std::min(kWidth, area.width() - 40);
+  const int height = std::min(kHeight, area.height() - 40);
+  int others = 0;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (host->IsFlechinha() && SameProfile(host, context)) {
+      ++others;
+    }
+  }
+  const int room = std::max(
+      1, std::min(area.width() - width, area.height() - height) / 2 / kCascade);
+  const int step = (others % room) * kCascade;
+  return gfx::Rect(area.x() + (area.width() - width) / 2 + step,
+                   area.y() + (area.height() - height) / 2 + step, width,
+                   height);
+}
+
+FlechaFrameHost* FlechinhaHost(int window_id,
+                               content::BrowserContext* context) {
+  FlechaFrameHost* host = HostForWindow(window_id, context);
+  return host && host->IsFlechinha() ? host : nullptr;
+}
+
+// A new Flechinha window, not shown yet and without tabs.
+BrowserWindowInterface* CreateFlechinhaWindow(Profile* profile) {
+  BrowserWindowCreateParams create(BrowserWindowInterface::TYPE_NORMAL,
+                                   *profile, /*from_user_gesture=*/true);
+  create.initial_bounds = FlechinhaBounds(profile);
+  create.omit_from_session_restore = true;
+  create.should_trigger_session_restore = false;
+  create.can_fullscreen = false;
+  base::AutoReset<bool> creating(&FlechaFrameHost::CreatingFlechinha(), true);
+  return CreateBrowserWindow(std::move(create));
+}
