+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_FLECHA_FLECHA_ACCELERATOR_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_ACCELERATOR_H_
+
+#include <optional>
+#include <string_view>
+
+#include "ui/base/accelerators/accelerator.h"
+
+// Parses one of Flecha's keyboard shortcuts, written as an Electron
+// accelerator ("CmdOrCtrl+Shift+T", "Alt+CmdOrCtrl+Left", "Ctrl+Tab", "Cmd+["):
+// modifiers (Cmd/Command/CmdOrCtrl/CommandOrControl/Super/Meta, Ctrl/Control,
+// Alt/Option, Shift) then one key: a letter, a digit, punctuation
+// ([ ] = - , . / ; ' ` \), Plus, Tab, Space, Enter/Return, Escape/Esc,
+// Backspace, Delete, Up/Down/Left/Right, Home, End, PageUp, PageDown or
+// F1-F24. Case doesn't matter. CmdOrCtrl is Command on macOS, Control
+// elsewhere. Returns nullopt for anything else.
+std::optional<ui::Accelerator> ParseFlechaAccelerator(std::string_view text);
+
+#endif  // CHROME_BROWSER_FLECHA_FLECHA_ACCELERATOR_H_
