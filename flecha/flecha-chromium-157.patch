+bool MaybeOpenLinkInFlechinha(Profile* profile, const GURL& url) {
+  if (!profile || !FlechaLinksOpenInFlechinha() || !url.is_valid()) {
+    return false;
+  }
+  profile = profile->GetOriginalProfile();
+  // Only once Flecha's window is up; at launch the link opens as usual.
+  if (!FlechaFrameHost::Main(profile) ||
+      GetBrowserWindowCreationStatusForProfile(*profile) !=
+          BrowserWindowInterface::CreationStatus::kOk) {
+    return false;
+  }
+  BrowserWindowInterface* browser = CreateFlechinhaWindow(profile);
+  chrome::AddTabAt(browser, url, -1, /*foreground=*/true);
+  browser->GetWindow()->Show();
+  browser->GetWindow()->Activate();
+  return true;
+}
