+// The Peek's page: shown in the peek view, kept out of the tab strip until
+// it's promoted. Its links to new tabs open in the window, as in the spike;
+// Escape closes it.
+class FlechaFrameView::Peek : public content::WebContentsDelegate,
+                              public content::WebContentsObserver {
+ public:
+  Peek(FlechaFrameView* frame, std::unique_ptr<content::WebContents> contents)
+      : content::WebContentsObserver(contents.get()),
+        frame_(frame),
+        contents_(std::move(contents)) {
+    contents_->SetDelegate(this);
+  }
+  ~Peek() override {
+    if (contents_) {
+      contents_->SetDelegate(nullptr);
+    }
+  }
+
+  content::WebContents* contents() { return contents_.get(); }
+
+  // Hands the page over (to the tab strip, for promotePeek()).
+  std::unique_ptr<content::WebContents> Release() {
+    Observe(nullptr);
+    contents_->SetDelegate(nullptr);
+    return std::move(contents_);
+  }
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    return frame_->browser_view_->browser()->OpenURL(
+        params, std::move(navigation_handle_callback));
+  }
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    // Real popups (OAuth, payment) stay popups; anything else is a tab.
+    if (disposition != WindowOpenDisposition::NEW_POPUP &&
+        disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB) {
+      disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    }
+    return chrome::AddWebContents(frame_->browser_view_->browser(), source,
+                                  std::move(new_contents), target_url,
+                                  disposition, window_features,
+                                  NavigateParams::WindowAction::kShowWindow,
+                                  user_gesture);
+  }
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    constexpr int kModifiers =
+        blink::WebInputEvent::kMetaKey | blink::WebInputEvent::kControlKey |
+        blink::WebInputEvent::kAltKey | blink::WebInputEvent::kShiftKey;
+    if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown &&
+        event.windows_key_code == ui::VKEY_ESCAPE &&
+        !(event.GetModifiers() & kModifiers) && !source->IsFullscreen()) {
+      ClosePeekSoon();
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    return frame_->browser_view_->PreHandleKeyboardEvent(event);
+  }
+  bool HandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    return frame_->browser_view_->HandleKeyboardEvent(event);
+  }
+  void CloseContents(content::WebContents* source) override {
+    ClosePeekSoon();
+  }
+
+  // content::WebContentsObserver:
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    frame_->SendPeekChanged();
+  }
+  void PrimaryPageChanged(content::Page& page) override {
+    frame_->SendPeekChanged();
+  }
+
+ private:
+  // Not while the page is calling us.
+  void ClosePeekSoon() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&FlechaFrameView::ClosePeek,
+                                  frame_->weak_factory_.GetWeakPtr()));
+  }
+
+  raw_ptr<FlechaFrameView> frame_;
+  std::unique_ptr<content::WebContents> contents_;
+};
