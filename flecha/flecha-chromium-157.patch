+void ComponentLoader::AddFlechaShellExtension() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  base::FilePath dir = command_line->GetSwitchValuePath("flecha-shell-dir");
+  if (dir.empty()) {
+    // Release builds carry the shell in the framework's Resources (the
+    // flecha_shell_dir GN arg in chrome/BUILD.gn); dev builds pass
+    // --flecha-shell-dir (chromium/scripts/run.sh).
+    if (!base::PathService::Get(chrome::DIR_RESOURCES, &dir)) {
+      return;
+    }
+    dir = dir.Append(FILE_PATH_LITERAL("flecha-shell"));
+  }
+  if (!dir.IsAbsolute()) {
+    LOG(ERROR) << "--flecha-shell-dir must be an absolute path: " << dir;
+    return;
+  }
+  // The manifest is read on the file thread; the reply comes after the
+  // extension system is ready (its Init runs in this task), so Add() loads the
+  // shell straight away. The window frame opens once it is ready.
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& dir) {
+            std::string error;
+            std::optional<base::DictValue> manifest =
+                file_util::LoadManifest(dir, &error);
+            if (!manifest) {
+              LOG(ERROR) << "Flecha's shell couldn't load from " << dir << ": "
+                         << error;
+            }
+            return manifest;
+          },
+          dir),
+      base::BindOnce(&ComponentLoader::FinishAddFlechaShell,
+                     weak_factory_.GetWeakPtr(), dir));
+}
+
+void ComponentLoader::FinishAddFlechaShell(
+    const base::FilePath& dir,
+    std::optional<base::DictValue> manifest) {
+  if (!manifest) {
+    return;
+  }
+  const ExtensionId id =
+      Add(std::move(*manifest), dir, /*skip_allowlist=*/false);
+  if (id != kFlechaShellExtensionId) {
+    LOG(ERROR) << "Flecha's shell at " << dir << " has the id " << id
+               << "; its manifest key must give " << kFlechaShellExtensionId;
+  }
+}
+
+void ComponentLoader::AddFlechaBundledExtensions() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  base::FilePath dir = command_line->GetSwitchValuePath("flecha-extensions-dir");
+  if (dir.empty()) {
+    if (!base::PathService::Get(chrome::DIR_RESOURCES, &dir)) {
+      return;
+    }
+    dir = dir.Append(FILE_PATH_LITERAL("flecha-extensions"));
+  }
+  if (!dir.IsAbsolute()) {
+    LOG(ERROR) << "--flecha-extensions-dir must be an absolute path: " << dir;
+    return;
+  }
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& dir) {
+            std::vector<std::pair<base::FilePath, base::DictValue>> manifests;
+            base::FileEnumerator folders(dir, /*recursive=*/false,
+                                         base::FileEnumerator::DIRECTORIES);
+            for (base::FilePath folder = folders.Next(); !folder.empty();
+                 folder = folders.Next()) {
+              std::string error;
+              std::optional<base::DictValue> manifest =
+                  file_util::LoadManifest(folder, &error);
+              if (!manifest) {
+                LOG(ERROR) << "Flecha: no extension in " << folder << ": "
+                           << error;
+                continue;
+              }
+              if (!manifest->FindString("key")) {
+                LOG(ERROR) << "Flecha: " << folder
+                           << " has no manifest key, so no stable id";
+                continue;
+              }
+              manifests.emplace_back(folder, std::move(*manifest));
+            }
+            return manifests;
+          },
+          dir),
+      base::BindOnce(&ComponentLoader::FinishAddFlechaBundledExtensions,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ComponentLoader::FinishAddFlechaBundledExtensions(
+    std::vector<std::pair<base::FilePath, base::DictValue>> manifests) {
+  for (auto& [folder, manifest] : manifests) {
+    Add(std::move(manifest), folder, /*skip_allowlist=*/true);
+  }
+}
