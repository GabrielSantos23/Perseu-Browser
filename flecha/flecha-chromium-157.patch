+void NativeViewHostMac::ApplyCornerRadiiToNativeView() {
+  if (!native_view_) {
+    return;
+  }
+  const float radius =
+      std::max({corner_radii_.upper_left(), corner_radii_.upper_right(),
+                corner_radii_.lower_right(), corner_radii_.lower_left()});
+  native_view_.wantsLayer = YES;
+  CALayer* layer = native_view_.layer;
+  layer.cornerRadius = radius;
+  layer.masksToBounds = radius > 0;
+  // CALayer's Y axis points up unless the view is flipped.
+  const bool flipped = native_view_.isFlipped;
+  const CACornerMask top_left =
+      flipped ? kCALayerMinXMinYCorner : kCALayerMinXMaxYCorner;
+  const CACornerMask top_right =
+      flipped ? kCALayerMaxXMinYCorner : kCALayerMaxXMaxYCorner;
+  const CACornerMask bottom_left =
+      flipped ? kCALayerMinXMaxYCorner : kCALayerMinXMinYCorner;
+  const CACornerMask bottom_right =
+      flipped ? kCALayerMaxXMaxYCorner : kCALayerMaxXMinYCorner;
+  CACornerMask corners = 0;
+  if (corner_radii_.upper_left() > 0) {
+    corners |= top_left;
+  }
+  if (corner_radii_.upper_right() > 0) {
+    corners |= top_right;
+  }
+  if (corner_radii_.lower_left() > 0) {
+    corners |= bottom_left;
+  }
+  if (corner_radii_.lower_right() > 0) {
+    corners |= bottom_right;
+  }
+  layer.maskedCorners = corners;
