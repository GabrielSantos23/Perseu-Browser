@@ -0,0 +1,91 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/flecha/flecha_frame_host.h"
+
+#include "base/no_destructor.h"
+
+namespace {
+
+std::vector<FlechaFrameHost*>& Hosts() {
+  static base::NoDestructor<std::vector<FlechaFrameHost*>> hosts;
+  return *hosts;
+}
+
+}  // namespace
+
+// static
+const std::vector<FlechaFrameHost*>& FlechaFrameHost::All() {
+  return Hosts();
+}
+
+// static
+std::optional<FlechaFrameState>& FlechaFrameHost::DefaultState() {
+  static std::optional<FlechaFrameState> state;
+  return state;
+}
+
+// static
+std::map<ui::Accelerator, std::string>& FlechaFrameHost::Shortcuts() {
+  static base::NoDestructor<std::map<ui::Accelerator, std::string>> shortcuts;
+  return *shortcuts;
+}
+
+// static
+FlechaFrameHost* FlechaFrameHost::ForWindow(int window_id) {
+  for (FlechaFrameHost* host : Hosts()) {
+    if (host->GetWindowId() == window_id) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+// static
+FlechaFrameHost* FlechaFrameHost::Main(content::BrowserContext* context) {
+  FlechaFrameHost* fallback = nullptr;
+  for (FlechaFrameHost* host : Hosts()) {
+    if (host->IsFlechinha() || host->GetBrowserContext() != context) {
+      continue;
+    }
+    if (host->IsActiveWindow()) {
+      return host;
+    }
+    fallback = host;
+  }
+  return fallback;
+}
+
+// static
+bool& FlechaFrameHost::CreatingFlechinha() {
+  static bool creating = false;
+  return creating;
+}
+
+// static
+std::set<int>& FlechaFrameHost::PeekTabs() {
+  static base::NoDestructor<std::set<int>> tabs;
+  return *tabs;
+}
+
+// static
+bool FlechaFrameHost::IsPeek(const content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  for (FlechaFrameHost* host : Hosts()) {
+    if (host->GetPeekContents() == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+FlechaFrameHost::FlechaFrameHost() {
+  Hosts().push_back(this);
+}
+
+FlechaFrameHost::~FlechaFrameHost() {
+  std::erase(Hosts(), this);
+}
diff --git a/chrome/browser/flecha/flecha_frame_host.h b/chrome/browser/flecha/flecha_frame_host.h
new file mode 100644
index 0000000000000000000000000000000000000000..ff06d0e0751c49dcb4bd4ede4e32b8e2e5aa8fa4
--- /dev/null
+++ b/chrome/browser/flecha/flecha_frame_host.h
@@ -0,0 +1,220 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_FLECHA_FLECHA_FRAME_HOST_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_FRAME_HOST_H_
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+
+class BrowserWindowInterface;
+class GURL;
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}
+
+// Flecha's window frame: the shell's frame page (window.html) is a transparent
+// view over each normal window, and the browser lays the page area and the
+// window controls out around it, the way the Electron spike's Browser.layout()
+// did (src/main/main.ts in the Flecha repo). chrome.flechaPrivate drives it;
+// the contract is chromium/shell/flechaPrivate.d.ts.
+//
+// This target (chrome/browser/flecha:flecha_frame_host) has no dependencies on
+// views so that the extension API can reach the frames, which live in the
+// browser views (chrome/browser/ui/views/frame/flecha_frame_view.h).
+
+// The spike's layout constants.
+inline constexpr int kFlechaSidebarWidth = 260;
+// With the sidebar hidden, this strip at the left edge brings it back on hover.
+inline constexpr int kFlechaEdgeWidth = 8;
+// The floating sidebar's inset from the window edge, and the room on its right
+// for its shadow.
+inline constexpr int kFlechaFloatMargin = 10;
+inline constexpr int kFlechaFloatShadow = 28;
+// Where the traffic lights sit (top-left of the close button) to line up with
+// the sidebar's toolbar.
+inline constexpr int kFlechaTrafficLightsX = 16;
+inline constexpr int kFlechaTrafficLightsY = 18;
+// The gap around the page area.
+inline constexpr int kFlechaGap = 8;
+// The corner radius of a Flecha window on macOS (measured).
+inline constexpr float kFlechaWindowCornerRadius = 20;
+// The page area's corner radius, concentric with the window's: it sits
+// kFlechaGap in. The shell's CSS has the same (--page-radius).
+inline constexpr float kFlechaPageCornerRadius =
+    kFlechaWindowCornerRadius - kFlechaGap;
+
+// Peek's card in the page area (the spike's peekBounds()): inset 8% of the
+// page area's width on each side, 48 from its top (room for the frame page's
+// Peek toolbar) and 24 from its bottom.
+inline gfx::Rect FlechaPeekBounds(const gfx::Rect& page) {
+  const int margin = static_cast<int>(page.width() * 0.08 + 0.5);
+  return gfx::Rect(page.x() + margin, page.y() + 48,
+                   std::max(0, page.width() - margin * 2),
+                   std::max(0, page.height() - 72));
+}
+
+// Flechinha (src/main/flechinha.ts): the frame page is a toolbar this tall
+// across the top, and the page sits under it, kFlechaGap from the other edges.
+inline constexpr int kFlechinhaToolbarHeight = 44;
+// Its traffic lights, level with the toolbar's controls.
+inline constexpr int kFlechinhaTrafficLightsX = 16;
+inline constexpr int kFlechinhaTrafficLightsY = 16;
+
+struct FlechaFrameState {
+  enum class Sidebar { kDocked, kHidden, kFloating };
+
+  Sidebar sidebar = Sidebar::kDocked;
+  bool overlay = false;
+  SkColor background = SkColorSetRGB(0xe9, 0xec, 0xf2);
+  // A Flechinha window: the browser sets this, never setFrame().
+  bool flechinha = false;
+  // The window is in fullscreen: the browser sets this, never setFrame().
+  bool fullscreen = false;
+
+  bool operator==(const FlechaFrameState&) const = default;
+
+  // The frame view's width, from the window's left edge.
+  int FrameWidth(int window_width) const {
+    if (overlay || flechinha) {
+      return window_width;
+    }
+    switch (sidebar) {
+      case Sidebar::kDocked:
+        return std::min(window_width, kFlechaSidebarWidth);
+      case Sidebar::kHidden:
+        return std::min(window_width, kFlechaEdgeWidth);
+      case Sidebar::kFloating:
+        return std::min(window_width, kFlechaFloatMargin + kFlechaSidebarWidth +
+                                          kFlechaFloatShadow);
+    }
+  }
+
+  // The frame view's height, from the window's top edge.
+  int FrameHeight(int window_height) const {
+    return flechinha && !overlay
+               ? std::min(window_height, kFlechinhaToolbarHeight)
+               : window_height;
+  }
+
+  // The page area, as insets from the window's edges.
+  gfx::Insets PageInsets() const {
+    // In fullscreen with the sidebar hidden or floating, the page fills the
+    // screen edge to edge, square, as in Arc (the layout drops its corners).
+    if (fullscreen && !flechinha && sidebar != Sidebar::kDocked) {
+      return gfx::Insets();
+    }
+    if (flechinha) {
+      return gfx::Insets::TLBR(kFlechinhaToolbarHeight, kFlechaGap, kFlechaGap,
+                               kFlechaGap);
+    }
+    return gfx::Insets::TLBR(
+        kFlechaGap,
+        sidebar == Sidebar::kDocked ? kFlechaSidebarWidth : kFlechaGap,
+        kFlechaGap, kFlechaGap);
+  }
+
+  bool TrafficLightsVisible() const {
+    return flechinha || sidebar != Sidebar::kHidden;
+  }
+
+  // Top-left of the close button, from the window's top-left corner.
+  gfx::Point TrafficLightsOrigin() const {
+    if (flechinha) {
+      return gfx::Point(kFlechinhaTrafficLightsX, kFlechinhaTrafficLightsY);
+    }
+    const int inset = sidebar == Sidebar::kFloating ? kFlechaFloatMargin : 0;
+    return gfx::Point(kFlechaTrafficLightsX + inset,
+                      kFlechaTrafficLightsY + inset);
+  }
+};
+
+// One per normal browser window that shows the frame (FlechaFrameView).
+class FlechaFrameHost {
+ public:
+  // Every live frame host, oldest first.
+  static const std::vector<FlechaFrameHost*>& All();
+
+  // The state that setFrame() last gave every window, for windows opened
+  // after it.
+  static std::optional<FlechaFrameState>& DefaultState();
+
+  // Flecha's keyboard shortcuts, from chrome.flechaPrivate.setShortcuts():
+  // each accelerator and the shell command it runs. Every window's frame
+  // takes these keys before the page and before Chromium's own shortcuts, and
+  // hands them to the shell (chrome.flechaPrivate.onShortcut).
+  static std::map<ui::Accelerator, std::string>& Shortcuts();
+
+  // The host of window `window_id`, or null.
+  static FlechaFrameHost* ForWindow(int window_id);
+  // The window Flecha's tabs live in: the last active window of `context`'s
+  // profile that is not a Flechinha, or null.
+  static FlechaFrameHost* Main(content::BrowserContext* context);
+  // True while chrome.flechaPrivate.openFlechinha() creates its window: the
+  // frame made meanwhile is that Flechinha's.
+  static bool& CreatingFlechinha();
+
+  // Tabs (extension tab ids) whose links to a new foreground tab open in Peek
+  // instead, like the spike's pinned tabs and favourites
+  // (chrome.flechaPrivate.setPeekTabs()).
+  static std::set<int>& PeekTabs();
+
+  // Peek: a page in a floating card over the page area (the spike's
+  // openPeek()). Opening one replaces the one before.
+  // `source` is the page whose link it is, if any: the Peek opens in its
+  // storage partition (a Space with separate cookies, flecha_spaces.h).
+  virtual void OpenPeek(const GURL& url, content::WebContents* source) = 0;
+  // Peek with a page that is already made (a window.open() from a Peek tab),
+  // so that it keeps its opener.
+  virtual void OpenPeekWithContents(
+      std::unique_ptr<content::WebContents> contents) = 0;
+  virtual void ClosePeek() = 0;
+  // The Peek's page becomes a normal tab in this window.
+  virtual void PromotePeek() = 0;
+  virtual bool HasPeek() const = 0;
+  // The Peek's page, or null.
+  virtual content::WebContents* GetPeekContents() = 0;
+  // Whether `contents` is a window's Peek: a page shown like a tab, that
+  // isn't one (the page context menu treats it as one, for Reload and Save).
+  static bool IsPeek(const content::WebContents* contents);
+
+  // The extension window ID (the window's session ID) of this host's window.
+  virtual int GetWindowId() const = 0;
+  // The profile of this host's window.
+  virtual content::BrowserContext* GetBrowserContext() = 0;
+  // The frame page's contents, or null before the shell is loaded.
+  virtual content::WebContents* GetFrameContents() = 0;
+  // Whether the window was the last one active (among this profile's).
+  virtual bool IsActiveWindow() const = 0;
+  virtual void SetFrameState(const FlechaFrameState& state) = 0;
+  virtual void FocusFrame() = 0;
+  virtual void FocusPage() = 0;
+  // Where extension popups open, in the frame page's coordinates.
+  virtual void SetPopupAnchor(const gfx::Rect& rect) = 0;
+  // Takes the keys in Shortcuts() from now on, and lets go of any others.
+  virtual void UpdateShortcuts() = 0;
+  // Whether the window is a Flechinha, Flecha's small window for one page.
+  virtual bool IsFlechinha() const = 0;
+  // The window itself.
+  virtual BrowserWindowInterface* GetBrowserWindowInterface() = 0;
+
+ protected:
+  FlechaFrameHost();
+  virtual ~FlechaFrameHost();
+};
+
+#endif  // CHROME_BROWSER_FLECHA_FLECHA_FRAME_HOST_H_
