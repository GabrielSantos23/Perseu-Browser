+ExtensionFunction::ResponseAction FlechaPrivateSetThemeFunction::Run() {
+  auto params = flecha_private::SetTheme::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  ThemeService::BrowserColorScheme scheme;
+  switch (params->theme) {
+    case flecha_private::Theme::kSystem:
+      scheme = ThemeService::BrowserColorScheme::kSystem;
+      break;
+    case flecha_private::Theme::kLight:
+      scheme = ThemeService::BrowserColorScheme::kLight;
+      break;
+    case flecha_private::Theme::kDark:
+      scheme = ThemeService::BrowserColorScheme::kDark;
+      break;
+    case flecha_private::Theme::kNone:
+      return RespondNow(BadMessage());
+  }
+  ThemeService* themes = ThemeServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(browser_context())->GetOriginalProfile());
+  if (themes->GetBrowserColorScheme() != scheme) {
+    themes->SetBrowserColorScheme(scheme);
+  }
+  return RespondNow(NoArguments());
+}
