+ExtensionFunction::ResponseAction FlechaPrivateOpenInFlechaFunction::Run() {
+  auto params = flecha_private::OpenInFlecha::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  FlechaFrameHost* flechinha =
+      FlechinhaHost(params->window_id, browser_context());
+  if (!flechinha) {
+    return RespondNow(Error("No Flechinha with id *.",
+                            base::NumberToString(params->window_id)));
+  }
+  FlechaFrameHost* main = FlechaFrameHost::Main(flechinha->GetBrowserContext());
+  if (!main) {
+    return RespondNow(Error("Flecha has no main window."));
+  }
+  BrowserWindowInterface* source = flechinha->GetBrowserWindowInterface();
+  BrowserWindowInterface* target = main->GetBrowserWindowInterface();
+  content::WebContents* contents =
+      source->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    return RespondNow(Error("The Flechinha has no page."));
+  }
+  const int tab_id = ExtensionTabUtil::GetTabId(contents);
+  std::string error;
+  const int index = tabs_util::MoveTabToWindow(
+      this, tab_id, target, -1, /*allow_other_window_types=*/true, &error);
+  if (index < 0) {
+    return RespondNow(Error(error));
+  }
+  target->GetTabStripModel()->ActivateTabAt(index);
+  target->GetWindow()->Activate();
+  // Empty now, so Chromium closes it; any other tabs it had stay with it.
+  return RespondNow(WithArguments(tab_id));
+}
