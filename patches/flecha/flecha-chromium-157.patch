+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+
+// Flecha has no horizontal tab strip and no toolbar/omnibox row: the sidebar
+// (Flecha's extension, shown in the side panel) owns tabs and the URL. This is
+// the one switch every native "hide top chrome" change asks.
+//
+// Only the *drawing* of the tab strip and toolbar is affected. The window still
+// supports tabs (WindowFeatureController is untouched), so new tabs, tab
+// commands and keyboard shortcuts keep working as in a normal tabbed window.
+//
+// Pass --flecha-show-top-chrome to get Chromium's tab strip and toolbar back,
+// which is handy when debugging.
+//
+// Incognito windows are Flecha windows too: the shell runs in split incognito
+// mode, so a second shell runs in the incognito profile and draws their frame.
+// Guest windows and other off-the-record profiles keep Chromium's tab strip
+// and toolbar: no shell runs there, so nothing else would show the URL.
+inline bool FlechaHidesTopChrome(const BrowserWindowInterface* browser) {
+  return browser &&
+         browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+         (!browser->GetProfile()->IsOffTheRecord() ||
+          browser->GetProfile()->IsIncognitoProfile()) &&
+         !browser->GetProfile()->IsGuestSession() &&
+         !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             "flecha-show-top-chrome");
+}
+
+// Height of the empty, draggable band that holds the window controls (the
+// macOS traffic lights) when top chrome is hidden.
+inline constexpr int kFlechaCaptionBandHeight = 38;
