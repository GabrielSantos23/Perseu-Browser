+ExtensionFunction::ResponseAction FlechaPrivateIsDefaultBrowserFunction::Run() {
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartCheckIsDefault(base::BindOnce(
+          [](scoped_refptr<FlechaPrivateIsDefaultBrowserFunction> function,
+             shell_integration::DefaultWebClientState state) {
+            function->Respond(function->WithArguments(DefaultBrowserState(state)));
+          },
+          scoped_refptr<FlechaPrivateIsDefaultBrowserFunction>(this)));
+  return RespondLater();
+}
+
+ExtensionFunction::ResponseAction
+FlechaPrivateMakeDefaultBrowserFunction::Run() {
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartSetAsDefault(base::BindOnce(
+          [](scoped_refptr<FlechaPrivateMakeDefaultBrowserFunction> function,
+             shell_integration::DefaultWebClientState state) {
+            function->Respond(function->WithArguments(DefaultBrowserState(state)));
+          },
+          scoped_refptr<FlechaPrivateMakeDefaultBrowserFunction>(this)));
+  return RespondLater();
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateGetFlechinhasFunction::Run() {
+  base::ListValue ids;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (host->IsFlechinha() && SameProfile(host, browser_context())) {
+      ids.Append(host->GetWindowId());
+    }
+  }
+  return RespondNow(WithArguments(std::move(ids)));
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateCreateTabFunction::Run() {
+  auto params = flecha_private::CreateTab::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const flecha_private::CreateTabOptions& options = params->options;
+
+  FlechaFrameHost* host =
+      options.window_id ? HostForWindow(*options.window_id, browser_context())
+                        : FlechaFrameHost::Main(browser_context());
+  if (!host || host->IsFlechinha()) {
+    return RespondNow(Error(kNoWindowError,
+                            options.window_id
+                                ? base::NumberToString(*options.window_id)
+                                : std::string("(main)")));
+  }
+  GURL url(chrome::kChromeUINewTabURL);
+  if (options.url && !options.url->empty()) {
+    url = GURL(*options.url);
+    if (!url.is_valid()) {
+      return RespondNow(Error("Invalid url: " + *options.url));
+    }
+  }
+
+  // The SiteInstance decides the storage partition, for the tab's life.
+  content::BrowserContext* context = browser_context();
+  const std::string partition = options.partition.value_or(std::string());
+  scoped_refptr<content::SiteInstance> site_instance =
+      partition.empty()
+          ? content::SiteInstance::CreateForURL(context, url)
+          : content::SiteInstance::CreateForFixedStoragePartition(
+                context, url, FlechaSpacePartition(context, partition));
+  const bool active = options.active.value_or(true);
+  content::WebContents::CreateParams create_params(context,
+                                                    std::move(site_instance));
+  create_params.initially_hidden = !active;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(create_params);
+  content::WebContents* raw = contents.get();
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+  host->GetBrowserWindowInterface()->GetTabStripModel()->AddWebContents(
+      std::move(contents), TabStripModel::kNoTab,
+      ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+      active ? AddTabTypes::ADD_ACTIVE : AddTabTypes::ADD_NONE);
+  return RespondNow(WithArguments(ExtensionTabUtil::GetTabId(raw)));
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateGetTabPartitionFunction::Run() {
+  auto params = flecha_private::GetTabPartition::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  return RespondNow(WithArguments(FlechaSpaceOf(contents)));
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateClearPartitionFunction::Run() {
+  auto params = flecha_private::ClearPartition::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (params->partition.empty()) {
+    return RespondNow(Error("Only a Space's own partition can be cleared."));
+  }
+  content::StoragePartition* partition = browser_context()->GetStoragePartition(
+      FlechaSpacePartition(browser_context(), params->partition));
+  // Cookies (session ones too), every kind of site storage, and the cache.
+  auto cookies = network::mojom::CookieDeletionFilter::New();
+  cookies->session_control =
+      network::mojom::CookieDeletionSessionControl::IGNORE_CONTROL;
+  pending_ = 2;
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL,
+      /*filter_builder=*/nullptr,
+      content::StoragePartition::StorageKeyPolicyMatcherFunction(),
+      std::move(cookies), /*perform_storage_cleanup=*/true, base::Time(),
+      base::Time::Max(),
+      base::BindOnce(&FlechaPrivateClearPartitionFunction::OnCleared, this));
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr,
+      base::BindOnce(&FlechaPrivateClearPartitionFunction::OnCleared, this));
+  return RespondLater();
+}
+
+void FlechaPrivateClearPartitionFunction::OnCleared() {
+  if (--pending_ == 0) {
+    Respond(NoArguments());
+  }
+}
+
+ExtensionFunction::ResponseAction
+FlechaPrivateRunInRegularProfileFunction::Run() {
+  auto params = flecha_private::RunInRegularProfile::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  base::ListValue event_args;
+  event_args.Append(params->command);
+  event_args.Append(-1);
+  DispatchFlechaShellEvent(
+      Profile::FromBrowserContext(browser_context())->GetOriginalProfile(),
+      "flechaPrivate.onShortcut", std::move(event_args));
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
