+constexpr char kNoWindowError[] = "No Flecha window with id *.";
+constexpr char kNotAFramePageError[] = "The caller is not a frame page.";
+constexpr char kBadColorError[] = "background must be #rrggbb.";
+constexpr char kNoTabError[] = "No tab with id *.";
+constexpr char kNotSplitError[] = "The tab is not in a split view.";
+
+std::optional<SkColor> ParseColor(const std::string& text) {
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' ||
+      !base::HexStringToUInt(std::string_view(text).substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+// Whether `host`'s window is one the calling shell answers for. The shell runs
+// in split incognito mode, so the regular shell and the incognito one each
+// have their own windows (and never reach the other's).
+bool SameProfile(FlechaFrameHost* host, content::BrowserContext* context) {
+  return host->GetBrowserContext() == context;
+}
+
+FlechaFrameHost* HostForWindow(int window_id,
+                               content::BrowserContext* context) {
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (host->GetWindowId() == window_id && SameProfile(host, context)) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+FlechaFrameHost* HostForContents(content::WebContents* contents) {
+  if (!contents) {
+    return nullptr;
+  }
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (host->GetFrameContents() == contents) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+FlechaFrameHost* ActiveHost(content::BrowserContext* context) {
+  FlechaFrameHost* fallback = nullptr;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (!SameProfile(host, context)) {
+      continue;
+    }
+    if (host->IsActiveWindow()) {
+      return host;
+    }
+    fallback = host;
+  }
+  return fallback;
+}
