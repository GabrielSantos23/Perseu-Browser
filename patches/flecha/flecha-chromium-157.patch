+ExtensionFunction::ResponseAction FlechaPrivateSetShortcutsFunction::Run() {
+  auto params = flecha_private::SetShortcuts::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::map<ui::Accelerator, std::string> shortcuts;
+  base::ListValue rejected;
+  for (const auto [keys, command] :
+       params->shortcuts.additional_properties) {
+    const std::optional<ui::Accelerator> accelerator =
+        ParseFlechaAccelerator(keys);
+    if (!accelerator || !command.is_string()) {
+      rejected.Append(keys);
+      continue;
+    }
+    shortcuts[*accelerator] = command.GetString();
+  }
+  FlechaFrameHost::Shortcuts() = std::move(shortcuts);
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    host->UpdateShortcuts();
+  }
+  return RespondNow(WithArguments(std::move(rejected)));
+}
