@@ -0,0 +1,31 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/flecha_frame_view.h"
+
+#import <AppKit/AppKit.h>
+
+#import "components/remote_cocoa/app_shim/browser_native_widget_window_mac.h"
+#include "ui/views/widget/widget.h"
+
+void SetFlechaTrafficLights(views::Widget* widget,
+                            const FlechaFrameState* state) {
+  if (!widget) {
+    return;
+  }
+  // Browser windows are in-process NSWindows (only PWAs may live in an app
+  // shim, and those never get a Flecha frame).
+  NSWindow* ns_window = widget->GetNativeWindow().GetNativeNSWindow();
+  if (![ns_window isKindOfClass:[BrowserNativeWidgetWindow class]]) {
+    return;
+  }
+  auto* window = static_cast<BrowserNativeWidgetWindow*>(ns_window);
+  if (!state) {
+    [window resetFlechaTrafficLights];
+    return;
+  }
+  const gfx::Point origin = state->TrafficLightsOrigin();
+  [window setFlechaTrafficLightsVisible:state->TrafficLightsVisible()
+                                 origin:NSMakePoint(origin.x(), origin.y())];
+}
