+ExtensionFunction::ResponseAction FlechaPrivateSetFrameFunction::Run() {
+  auto params = flecha_private::SetFrame::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  FlechaFrameState state;
+  switch (params->state.sidebar) {
+    case flecha_private::SidebarMode::kDocked:
+      state.sidebar = FlechaFrameState::Sidebar::kDocked;
+      break;
+    case flecha_private::SidebarMode::kHidden:
+      state.sidebar = FlechaFrameState::Sidebar::kHidden;
+      break;
+    case flecha_private::SidebarMode::kFloating:
+      state.sidebar = FlechaFrameState::Sidebar::kFloating;
+      break;
+    case flecha_private::SidebarMode::kNone:
+      return RespondNow(BadMessage());
+  }
+  state.overlay = params->state.overlay;
+  std::optional<SkColor> background = ParseColor(params->state.background);
+  if (!background) {
+    return RespondNow(Error(kBadColorError));
+  }
+  state.background = *background;
+
+  if (params->window_id) {
+    FlechaFrameHost* host = HostForWindow(*params->window_id, browser_context());
+    if (!host) {
+      return RespondNow(Error(kNoWindowError,
+                              base::NumberToString(*params->window_id)));
+    }
+    host->SetFrameState(state);
+    return RespondNow(NoArguments());
+  }
+
+  FlechaFrameHost::DefaultState() = state;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (SameProfile(host, browser_context())) {
+      host->SetFrameState(state);
+    }
+  }
+  return RespondNow(NoArguments());
+}
