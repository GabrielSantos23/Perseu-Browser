+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_FLECHA_FLECHA_SHELL_EVENTS_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_SHELL_EVENTS_H_
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+#include "chrome/browser/flecha/flecha_shell.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_event_histogram_value.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/event_args.h"
+
+// The profile whose shell answers for a window of `profile`. The shell runs in
+// split incognito mode: an incognito window has a shell of its own (with its
+// own tabs and state), every other window the regular profile's.
+inline Profile* FlechaShellProfile(Profile* profile) {
+  return profile->IsIncognitoProfile() ? profile
+                                       : profile->GetOriginalProfile();
+}
+
+// Sends one of chrome.flechaPrivate's events ("flechaPrivate.onSomething") to
+// Flecha's shell, and only to it: the shell of `profile`'s windows (see
+// FlechaShellProfile). Header-only, like flecha_shell_commands.h, so that any
+// browser code can send one without a new dependency.
+inline void DispatchFlechaShellEvent(Profile* profile,
+                                     const std::string& event_name,
+                                     base::ListValue args) {
+  profile = FlechaShellProfile(profile);
+  if (!extensions::ExtensionRegistry::Get(profile)
+           ->enabled_extensions()
+           .Contains(kFlechaShellExtensionId)) {
+    return;
+  }
+  auto event_args = base::MakeRefCounted<extensions::EventArgs>();
+  event_args->data = std::move(args);
+  auto event = std::make_unique<extensions::Event>(
+      extensions::events::UNKNOWN, event_name, std::move(event_args), profile);
+  extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+      kFlechaShellExtensionId, std::move(event));
+}
+
+#endif  // CHROME_BROWSER_FLECHA_FLECHA_SHELL_EVENTS_H_
diff --git a/chrome/browser/flecha/flecha_spaces.h b/chrome/browser/flecha/flecha_spaces.h
