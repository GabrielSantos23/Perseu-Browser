+ExtensionFunction::ResponseAction FlechaPrivateOpenDevToolsFunction::Run() {
+  auto params = flecha_private::OpenDevTools::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  const bool toggle = params->options && params->options->toggle.value_or(false);
+  const bool console =
+      params->options && params->options->console.value_or(false);
+  DevToolsWindow::OpenDevToolsWindow(
+      contents,
+      console  ? DevToolsToggleAction::ShowConsolePanel()
+      : toggle ? DevToolsToggleAction::Toggle()
+               : DevToolsToggleAction::Show(),
+      console ? DevToolsOpenedByAction::kConsoleShortcut
+              : DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+  return RespondNow(NoArguments());
+}
