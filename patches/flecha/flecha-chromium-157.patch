+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_FLECHA_FRAME_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_FLECHA_FRAME_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/flecha/flecha_frame_host.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+#include "third_party/blink/public/mojom/page/draggable_region.mojom-forward.h"
+#include "third_party/skia/include/core/SkRegion.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/view_tracker.h"
+
+class BrowserView;
+
+namespace views {
+class FocusManager;
+class Widget;
+}
+
+// Puts the window controls (the macOS traffic lights) of `widget` where
+// `state` wants them, or gives them back to the platform when `state` is null.
+// A no-op off macOS.
+void SetFlechaTrafficLights(views::Widget* widget,
+                            const FlechaFrameState* state);
+
+// Flecha's window frame (see flecha_frame_host.h): the shell's frame page,
+// chrome-extension://<shell>/window.html?window=<id>, in a transparent view
+// stacked above the page area of a normal browser window, plus the window
+// background behind the page area. chrome.flechaPrivate.setFrame() says where
+// the sidebar is; the browser view layout puts this view and the page area
+// where the state says (BrowserViewTabbedLayoutImpl).
+//
+// The frame shows only while the shell is loaded; without it the window keeps
+// Chromium's layout (with top chrome hidden, see flecha_top_chrome.h).
+class FlechaFrameView : public views::WebView,
+                        public FlechaFrameHost,
+                        public extensions::ExtensionRegistryObserver {
+  METADATA_HEADER(FlechaFrameView, views::WebView)
+
+ public:
+  // Adds the frame and its background to `browser_view`, if it is a normal
+  // window with top chrome hidden. Returns the frame, owned by `browser_view`.
+  static FlechaFrameView* MaybeCreate(BrowserView* browser_view);
+
+  // The frame of `browser_view`, if it has one.
+  static FlechaFrameView* From(views::View* browser_view);
+
+  explicit FlechaFrameView(BrowserView* browser_view);
+  FlechaFrameView(const FlechaFrameView&) = delete;
+  FlechaFrameView& operator=(const FlechaFrameView&) = delete;
+  ~FlechaFrameView() override;
+
+  // The window background behind the page area. Its insets are the page area's
+  // insets from the window's edges.
+  views::View* background_view() { return background_view_.view(); }
+
+  // Peek's card (a web view above the frame), hidden unless a Peek is open.
+  views::View* peek_view() { return peek_view_.view(); }
+
+  // What extension popups anchor to, the toolbar being hidden: an empty view
+  // over the frame, placed by SetPopupAnchor().
+  views::View* popup_anchor() { return popup_anchor_.view(); }
+
+  const FlechaFrameState& state() const { return state_; }
+
+  // Whether the frame lays out the window (the shell is loaded).
+  bool IsActive() const { return GetVisible(); }
+
+  // The window's hit test at `point` (in the browser view's coordinates):
+  // HTCAPTION where the frame page marks -webkit-app-region: drag and in the
+  // window background around the page area, HTCLIENT elsewhere in the frame
+  // view and in the page area, HTNOWHERE elsewhere or while inactive.
+  int NonClientHitTest(const gfx::Point& point) const;
+
+  // views::WebView:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // FlechaFrameHost:
+  int GetWindowId() const override;
+  content::BrowserContext* GetBrowserContext() override;
+  content::WebContents* GetFrameContents() override;
+  bool IsActiveWindow() const override;
+  bool IsFlechinha() const override;
+  BrowserWindowInterface* GetBrowserWindowInterface() override;
+  void SetFrameState(const FlechaFrameState& state) override;
+  void FocusFrame() override;
+  void FocusPage() override;
+  void SetPopupAnchor(const gfx::Rect& rect) override;
+  void UpdateShortcuts() override;
+  void OpenPeek(const GURL& url, content::WebContents* source) override;
+  void OpenPeekWithContents(
+      std::unique_ptr<content::WebContents> contents) override;
+  void ClosePeek() override;
+  void PromotePeek() override;
+  bool HasPeek() const override;
+  content::WebContents* GetPeekContents() override;
+
+  // Tells the shell about the Peek (chrome.flechaPrivate.onPeekChanged).
+  void SendPeekChanged();
+
+  // content::WebContentsDelegate (through views::WebView):
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+  void DraggableRegionsChanged(
+      const std::vector<blink::mojom::DraggableRegionPtr>& regions,
+      content::WebContents* contents) override;
+  // "fullscreen" while the window is, so the frame page's CSS can match
+  // (display-mode: fullscreen): no room for the traffic lights then.
+  blink::mojom::DisplayMode GetDisplayMode(
+      const content::WebContents* source) override;
+
+  // The window entered or left fullscreen (BrowserView): the page area and the
+  // frame page's display mode follow.
+  void OnWindowFullscreenChanged();
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionReady(content::BrowserContext* browser_context,
+                        const extensions::Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override;
+
+ private:
+  // Opens the frame page (the shell is loaded), or closes it (it is not).
+  void OpenFramePage();
+  void CloseFramePage();
+
+  // Applies `state_` to the background, the layout and the window controls.
+  void ApplyState();
+
+  // Takes Flecha's shortcuts (FlechaFrameHost::Shortcuts()) at the window's
+  // focus manager with high priority, the way extension commands are: on
+  // macOS that is before the page and before the main menu's key
+  // equivalents, so Cmd+S toggles the sidebar instead of saving the page.
+  class ShortcutTarget : public ui::AcceleratorTarget {
+   public:
+    explicit ShortcutTarget(FlechaFrameView* frame) : frame_(frame) {}
+    bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+    bool CanHandleAccelerators() const override;
+
+   private:
+    raw_ptr<FlechaFrameView> frame_;
+  };
+  void UnregisterShortcuts();
+
+  // The Peek's page and its delegate (flecha_frame_view.cc).
+  class Peek;
+  friend class Peek;
+  std::unique_ptr<Peek> peek_;
+
+  raw_ptr<BrowserView> browser_view_;
+  // Owned by `browser_view_`, like this view; it may go first.
+  views::ViewTracker background_view_;
+  views::ViewTracker peek_view_;
+  views::ViewTracker popup_anchor_;
+  std::unique_ptr<content::WebContents> frame_contents_;
+  FlechaFrameState state_;
+  // The frame page's -webkit-app-region: drag areas, in this view's
+  // coordinates.
+  SkRegion draggable_region_;
+
+  ShortcutTarget shortcut_target_{this};
+  // The focus manager that has our shortcuts, if any.
+  raw_ptr<views::FocusManager> shortcuts_focus_manager_ = nullptr;
+
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+
+  base::WeakPtrFactory<FlechaFrameView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_FLECHA_FRAME_VIEW_H_
